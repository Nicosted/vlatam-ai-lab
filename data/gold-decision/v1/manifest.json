  "labeling_rules": [
    {
      "rule_id": "rule.citation_completeness.v1",
      "capability_id": "synthetic.decision.claim_citation_complete",
      "statement": "R-CIT-1: a synthetic packet is fully cited (true) iff claims_count is at least 1 and claims_with_citation_count equals claims_count; otherwise false."
    },
    {
      "rule_id": "rule.document_completeness_0_4.v1",
      "capability_id": "synthetic.decision.document_completeness_score",
      "statement": "R-CMP-1 on scale synthetic.completeness.0_4: score = floor(4 * present_fields / required_fields), counting illegible fields as not present. When illegible_fields > 0 and floor(4 * (present_fields + illegible_fields) / required_fields) is higher, every integer between the two bounds is acceptable. If required_fields is 0 the score is undefined and abstention is required."
    },
    {
      "rule_id": "rule.document_queue_order.v1",
      "capability_id": "synthetic.decision.document_queue_rank",
      "statement": "R-QUE-1: order the queued synthetic documents by ascending expires_in_days. Cases never contain ties."
    },
    {
      "rule_id": "rule.document_type.v1",
      "capability_id": "synthetic.decision.document_type_classify",
      "statement": "R-DOC-1: markers are has_unit_prices (invoice), has_package_weights (packing_list), has_certifying_body_declaration (certificate), numbered_safety_sections equal to 16 (msds) and has_carrier_and_ports (transport_document). Exactly one marker determines the type; no marker yields unknown; two or more markers make the document ambiguous and abstention is required. The declared title never overrides the markers."
    },
    {
      "rule_id": "rule.evidence_sufficiency.v1",
      "capability_id": "synthetic.decision.evidence_sufficiency",
      "statement": "R-EVD-1: sufficient iff every listed required item is present_verified; insufficient iff any item is missing; uncertain iff no item is missing and at least one is present_unverified. If the declared required_items count differs from the number of listed items the facts contradict each other and abstention is required."
    },
    {
      "rule_id": "rule.human_review_routing.v1",
      "capability_id": "synthetic.decision.human_review_required",
      "statement": "R-HRV-1: true iff the synthetic item declares hazardous goods, declares a value of at least 10000 USD, has unverified evidence or contains a regulatory claim; otherwise false. The rule answers only this synthetic routing question and never removes a review required by another policy."
    },
    {
      "rule_id": "rule.regulatory_relevance.v1",
      "capability_id": "synthetic.decision.regulatory_relevance_triage",
      "statement": "R-REG-1 (synthetic scenario, no legal advice): if notice.jurisdiction is undeclared abstention is required; else if notice.jurisdiction differs from operation.destination_jurisdiction the notice is not_relevant; else if operation.product_category is undeclared it is uncertain; else relevant iff the product categories match, otherwise not_relevant."
    },
    {
      "rule_id": "rule.workflow_next_step.v1",
      "capability_id": "synthetic.decision.workflow_next_step",
      "statement": "R-WFL-1: first match in order: on_hold -> hold; missing_required_documents > 0 -> request_information; unextracted_documents > 0 -> document_extraction; open_regulatory_questions > 0 -> regulatory_research; route_defined false -> logistics_analysis; otherwise human_review. If the selected step is not a declared option abstention is required."
    },
    {
      "rule_id": "rule.workflow_priority.v1",
      "capability_id": "synthetic.decision.workflow_priority_rank",
      "statement": "R-PRI-1: order synthetic tasks by ascending deadline_days, breaking ties by descending blocked_operations. Cases never tie on both keys."
    }
  ],
