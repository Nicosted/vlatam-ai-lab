    {
      "claim_id": "claim-base-models",
      "claim_kind": "base_model_relationship",
      "statement": "Model cards declare LoRA adapters over Qwen3.5-0.8B, 4B and 9B Base; Kev-27B starts from post-trained Qwen3.8-27B, whose training data the README says is unknown.",
      "evidence_refs": [
        "ev-card-kev-0.8b",
        "ev-card-kev-27b",
        "ev-card-kev-4b",
        "ev-card-kev-9b",
        "ev-readme"
      ],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-calibration",
      "claim_kind": "calibration",
      "statement": "README states each checkpoint ships a temperature fitted on in-distribution development data (Kev-27B 1.38, Kev-9B 2.30, Kev-4B 2.41, Kev-0.8B 2.35).",
      "evidence_refs": ["ev-readme"],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-eval-suites",
      "claim_kind": "evaluation_documentation",
      "statement": "README states evaluation data under evals/ is frozen with dataset versions and checksums recorded, and that locked test partitions are read once per candidate.",
      "evidence_refs": ["ev-readme"],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-execution-surfaces",
      "claim_kind": "execution_surface",
      "statement": "README states local serving on CUDA or ROCm GPUs and MLX on Apple Silicon, a TypeSafe-compatible HTTP API and a one-command hosted deployment on Modal.",
      "evidence_refs": ["ev-readme"],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-performance",
      "claim_kind": "performance",
      "statement": "README reports new-source development/test accuracy from 0.648/0.697 (Kev-0.8B) to 0.848/0.896 (Kev-27B).",
      "evidence_refs": ["ev-readme"],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-training-data",
      "claim_kind": "training_methodology",
      "statement": "README states the released models share the decision-v7 training set: 10,000 examples from ten public datasets plus generated policy and rule-structure examples.",
      "evidence_refs": ["ev-readme"],
      "verification": "upstream_claim"
    },
    {
      "claim_id": "claim-weights",
      "claim_kind": "weights_reference",
      "statement": "README lists four sizes (0.8B, 4B, 9B, 27B) with weights on Hugging Face and in a GitHub release with SHA-256 checksums.",
