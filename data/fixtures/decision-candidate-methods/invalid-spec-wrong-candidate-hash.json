    "interpretations": [
      {
        "topic": "boolean_decisions",
        "disposition": "not_supported",
        "statement": "The pinned direct mode scores 2-16 described options and has no boolean mode. AI-140 boolean requests declare no described alternatives, so AI-144 defines no boolean-to-option mapping and blocks boolean requests before process creation.",
        "evidence_refs": ["ev-core-source", "ev-method-doc"]
      },
      {
        "topic": "calibration",
        "disposition": "not_applied",
        "statement": "Upstream documents an optional per-workload temperature fitted on labeled rows (softmax of logits divided by T). AI-144 fits and applies no temperature, consumes no AI-141 labels and does not reproduce or verify the upstream calibration claims.",
        "evidence_refs": ["ev-calibration-doc", "ev-readme"]
      },
      {
        "topic": "logit_source",
        "disposition": "replaced_by_synthetic",
        "statement": "Upstream reads native last-position logits of a pinned model restricted to single-token answer letters. AI-144 loads no model, tokenizer or weights; repository-owned synthetic integer micro-logits bound by candidate id stand in for them.",
        "evidence_refs": ["ev-direct-source", "ev-model-manifest"]
      },
      {
        "topic": "normalization",
        "disposition": "adopted",
        "statement": "Softmax over the declared option logits only, with the maximum logit subtracted before exponentiation; at least two finite values are required.",
        "evidence_refs": ["ev-core-source", "ev-direct-source", "ev-method-doc"]
      },
      {
        "topic": "option_construction",
        "disposition": "adopted",
        "statement": "Each decision declares 2-16 options with unique string ids and descriptions. AI-144 maps AI-140 choice candidates (candidate_id, label) onto this and blocks fewer than 2 or more than 16 candidates.",
        "evidence_refs": ["ev-core-source", "ev-readme"]
      },
      {
        "topic": "option_ordering",
        "disposition": "ai_lab_policy",
        "statement": "Upstream assigns answer letters by display position and measures reordering stability after aligning by option id. AI-144 binds logits to candidate ids, computes in ascending candidate-id order and serializes AI-140 distributions in that order.",
        "evidence_refs": ["ev-core-source", "ev-method-doc"]
      },
      {
        "topic": "probability_representation",
        "disposition": "ai_lab_policy",
        "statement": "Upstream emits floating-point probabilities. AI-144 converts them to AI-140 integer micros: floor each value, give the remaining micros to the largest remainders with ties by ascending candidate id, summing to exactly 1000000.",
        "evidence_refs": ["ev-direct-source"]
      },
      {
        "topic": "prompt_construction",
        "disposition": "not_applicable",
        "statement": "Upstream builds a fixed system prompt plus a JSON payload of evidence, criterion and lettered option descriptions and applies a chat template. AI-144 builds, tokenizes and hashes no prompt because no model runs.",
        "evidence_refs": ["ev-core-source", "ev-direct-source"]
      },
      {
        "topic": "score_and_ranking_decisions",
        "disposition": "not_supported",
        "statement": "The direct mode is categorical. Ranking appears upstream only through a separate reranker system with a different pinned model, and no direct score mode exists, so AI-140 score and ranking requests fail closed.",
        "evidence_refs": ["ev-method-doc", "ev-readme"]
      },
      {
        "topic": "selection",
        "disposition": "adopted",
        "statement": "The upstream scorer returns probabilities without selecting; the upstream evaluator and calibration notes treat the argmax as the decision. AI-144 selects the unique maximum logit as method-specific behavior, not as an AI-140 validation rule.",
        "evidence_refs": [
          "ev-calibration-doc",
          "ev-direct-source",
          "ev-evaluator-source"
        ]
      },
      {
        "topic": "top_logit_tie",
        "disposition": "fail_closed",
        "statement": "The upstream evaluator breaks ties by first position in option order, which depends on display order. AI-144 defines no positional tie-break: a tie at the maximum logit is refused and no result is produced.",
        "evidence_refs": ["ev-evaluator-source"]
      }
    ]
  },
