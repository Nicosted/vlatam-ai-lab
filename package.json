    "ai:handoff:validate-authorization": "tsx scripts/handoff.ts validate-authorization",
    "ai:handoff:validate-decision": "tsx scripts/handoff.ts validate-decision",
    "ai:handoff:fixture": "tsx scripts/handoff.ts fixture",
    "ai:handoff:concurrency": "tsx scripts/handoff.ts concurrency",
    "ai:handoff:reusable": "tsx scripts/handoff.ts reusable",
    "ai:handoff:profile-version-mismatch": "tsx scripts/handoff.ts profile-version-mismatch",
    "ai:authorization-store": "tsx scripts/authorization-store.ts",
    "ai:openrouter:sandbox": "tsx scripts/openrouter-sandbox-harness.ts",
