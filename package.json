{
  "name": "vlatam-ai-lab",
  "version": "0.5.1",
  "private": true,
  "description": "Experimental AI operations and regulatory intelligence lab for vLatamGlobal (production-isolated sandbox).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ai:extract": "tsx scripts/run-extraction.ts",
    "ai:validate-packet": "tsx scripts/validate-packet.ts",
    "ai:validate-extraction": "tsx scripts/validate-extraction.ts",
    "crawler:arca": "tsx src/crawlers/arca-crawler.ts",
    "crawler:arca:real": "tsx src/crawlers/arca-real-crawler.ts",
    "crawler:packet": "tsx src/crawlers/generate-packet-from-arca.ts",
    "crawler:infoleg": "tsx src/crawlers/infoleg-crawler.ts",
    "crawler:vuce-extract": "tsx src/crawlers/vuce-extractor.ts",
    "crawler:vuce-notes": "tsx src/crawlers/vuce-notes-parser.ts",
    "crawler:unified-packet": "tsx src/crawlers/generate-unified-packet.ts",
    "sync:kv": "tsx scripts/sync-kv.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "ai:extract:dry-run": "tsx src/pipelines/ai-extract-dry-run.ts",
    "ai:extract:demo": "AI_EXTRACT_MODE=demo tsx src/pipelines/ai-extract-dry-run.ts",
    "ai:extract:record-qwen-demo": "tsx src/pipelines/ai-extract-record-qwen-demo.ts",
    "ai:extract:replay-qwen-demo": "tsx src/pipelines/ai-extract-replay-qwen-demo.ts",
    "ai:review:check:argentina-backpack": "tsx src/pipelines/check-argentina-backpack-approval-readiness.ts",
    "ai:review:handoff:argentina-backpack": "tsx src/pipelines/build-argentina-backpack-missing-data-handoff.ts",
    "ai:exports:verify": "tsx src/pipelines/verify-approved-export-catalog.ts",
    "ai:exports:bundle": "tsx src/pipelines/build-approved-export-bundle.ts",
    "pcram:delta": "tsx src/pipelines/pcram-delta.ts",
    "pcram:validate-snapshot": "tsx src/pipelines/validate-pcram-source-snapshot.ts snapshots/pcram/example-source-snapshot.json",
    "pcram:generate-delta": "tsx src/pipelines/generate-pcram-delta.ts snapshots/pcram/example-source-snapshot-previous.json snapshots/pcram/example-source-snapshot-current.json snapshots/pcram/example-delta.json",
    "pcram:generate-evidence": "tsx src/pipelines/generate-pcram-evidence-report.ts snapshots/pcram/example-source-snapshot-previous.json snapshots/pcram/example-source-snapshot-current.json snapshots/pcram/example-delta.json reports/example-pcram-generated-evidence-report.md",
    "schema:readiness": "tsx src/reports/schema-readiness-report.ts reports/schema-readiness-p1.md && prettier --write reports/schema-readiness-p1.md",
    "intelligence:briefing": "tsx src/reports/operational-briefing-preview.ts reports/operational-briefing-preview-p1.md && prettier --write reports/operational-briefing-preview-p1.md",
    "intelligence:quality-gate": "pnpm intelligence:briefing && tsx src/reports/briefing-quality-gate.ts reports/operational-briefing-preview-p1.md reports/briefing-quality-gate-p1.md && prettier --write reports/briefing-quality-gate-p1.md"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@eslint/js": "^9.18.0",
    "@types/ajv": "^1.0.4",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.25",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}
