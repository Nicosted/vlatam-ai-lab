  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
