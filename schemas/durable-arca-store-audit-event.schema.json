{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/durable-arca-store-audit-event.schema.json",
  "title": "Durable ARCA append-only audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "event_sha256",
    "event_timestamp",
    "sequence",
    "operation",
    "actor_identity",
    "candidate_id",
    "candidate_sha256",
    "review_id",
    "review_sha256",
    "evaluation_id",
    "evaluation_sha256",
    "approved_artifact_id",
    "approved_artifact_sha256",
    "previous_event_id",
    "previous_event_sha256",
    "store_configuration_sha256",
    "outcome",
    "export_authorized",
    "publication_authorized",
    "production_authorized",
    "network_authorized",
    "database_authorized",
    "scheduler_authorized",
    "deployment_authorized",
    "vlatam_global_access_authorized"
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "durable_arca_store_audit_event" },
    "event_id": {
      "type": "string",
      "pattern": "^arca-store-event--[a-f0-9]{64}$"
    },
    "event_sha256": { "$ref": "#/$defs/sha" },
    "event_timestamp": { "$ref": "#/$defs/timestamp" },
    "sequence": { "type": "integer", "minimum": 1 },
    "operation": {
      "enum": [
        "record_candidate",
        "record_review",
        "record_evaluation",
        "record_approved_artifact",
        "rebuild_projection"
      ]
    },
    "actor_identity": {
      "type": "string",
      "pattern": "^(?:human:[a-z0-9][a-z0-9._@-]*|service:durable-arca-store@1\\.0\\.0)$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^arca-candidate--[a-f0-9]{64}$"
    },
    "candidate_sha256": { "$ref": "#/$defs/sha" },
    "review_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^arca-review--[a-f0-9]{64}$" }
      ]
    },
    "review_sha256": { "$ref": "#/$defs/nullableSha" },
    "evaluation_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^arca-review-evaluation--[a-f0-9]{64}$"
        }
      ]
    },
    "evaluation_sha256": { "$ref": "#/$defs/nullableSha" },
    "approved_artifact_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^approved-arca-artifact--[a-f0-9]{64}$"
        }
      ]
    },
    "approved_artifact_sha256": { "$ref": "#/$defs/nullableSha" },
    "previous_event_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^arca-store-event--[a-f0-9]{64}$" }
      ]
    },
    "previous_event_sha256": { "$ref": "#/$defs/nullableSha" },
    "store_configuration_sha256": {
      "const": "8981af30a972974dc2930b886202dff3cdca6a17853859524cbead5d31b204c4"
    },
    "outcome": { "enum": ["recorded", "projection_rebuilt"] },
    "export_authorized": { "const": false },
    "publication_authorized": { "const": false },
    "production_authorized": { "const": false },
    "network_authorized": { "const": false },
    "database_authorized": { "const": false },
    "scheduler_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "vlatam_global_access_authorized": { "const": false }
  }
}
