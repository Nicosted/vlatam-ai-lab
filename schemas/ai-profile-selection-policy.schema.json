{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam.local/schemas/ai-profile-selection-policy.schema.json",
  "title": "AI-78 profile selection policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "capability_id",
    "permitted_lifecycle_states",
    "required_benchmark_suites",
    "required_ranking_policy",
    "maximum_evidence_age_seconds",
    "required_quality_gates",
    "allowed_data_classifications",
    "allowed_budget_classes",
    "human_review"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "$ref": "#/$defs/id" },
    "policy_version": { "$ref": "#/$defs/semver" },
    "capability_id": { "$ref": "#/$defs/id" },
    "permitted_lifecycle_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["production", "candidate", "shadow", "retired"] }
    },
    "required_benchmark_suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ref" }
    },
    "required_ranking_policy": { "$ref": "#/$defs/ref" },
    "maximum_evidence_age_seconds": { "type": "integer", "minimum": 0 },
    "required_quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "allowed_data_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "regulated",
          "restricted"
        ]
      }
    },
    "allowed_budget_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["development", "unclassified"] }
    },
    "required_budget_policy_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "allowed_reviewer_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "allowed_jurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_regulatory_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "allowed_reasons"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/id" },
        "profile_version": { "$ref": "#/$defs/semver" },
        "allowed_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "human_review": { "enum": ["required", "on_policy", "not_required"] },
    "decision_ttl_seconds": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "human_review": { "enum": ["required", "on_policy"] } }
      },
      "then": { "properties": { "allowed_reviewer_roles": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reason": {
      "enum": [
        "REVIEWED_WINNER_ELIGIBLE",
        "FALLBACK_ELIGIBLE",
        "REVIEW_REQUIRED",
        "REVIEW_REJECTED",
        "REVIEWER_ROLE_UNAUTHORIZED",
        "SCHEMA_OR_POLICY_INVALID",
        "CAMPAIGN_NOT_COMPLETED",
        "WINNER_NOT_UNIQUE",
        "EVIDENCE_INTEGRITY_FAILED",
        "EVIDENCE_STALE",
        "EVIDENCE_SUPERSEDED",
        "REVIEW_ATTESTATION_INVALID",
        "PROFILE_REFERENCE_CONFLICT",
        "PROFILE_INELIGIBLE",
        "PRIVACY_INCOMPATIBLE",
        "BUDGET_CLASS_INCOMPATIBLE",
        "BUDGET_POLICY_INCOMPATIBLE",
        "JURISDICTION_INCOMPATIBLE",
        "QUALITY_GATES_UNPROVEN",
        "FALLBACK_NOT_ALLOWED",
        "FALLBACK_INELIGIBLE"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "type"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "coverage_complete",
            "no_blocked_or_rejected",
            "minimum_score",
            "dimension_perfect"
          ]
        },
        "minimum_score": { "$ref": "#/$defs/ratio" },
        "dimension_type": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "minimum_score" } } },
          "then": {
            "required": ["minimum_score"],
            "not": { "required": ["dimension_type"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "dimension_perfect" } } },
          "then": {
            "required": ["dimension_type"],
            "not": { "required": ["minimum_score"] }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["coverage_complete", "no_blocked_or_rejected"]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["minimum_score"] },
                { "required": ["dimension_type"] }
              ]
            }
          }
        }
      ]
    }
  }
}
