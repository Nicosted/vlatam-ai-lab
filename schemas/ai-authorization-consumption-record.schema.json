{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam.local/schemas/ai-authorization-consumption-record.schema.json",
  "title": "AI-80 durable authorization consumption record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "handoff_policy_id",
    "handoff_policy_version",
    "handoff_policy_hash",
    "decision_hash",
    "authorization_mode",
    "state",
    "consumed_at",
    "execution_correlation_id",
    "audit_correlation_id",
    "created_at"
  ],
  "properties": {
    "authorization_id": { "type": "string" },
    "handoff_policy_id": { "type": "string" },
    "handoff_policy_version": { "type": "string" },
    "handoff_policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorization_mode": { "enum": ["single_use", "reusable"] },
    "state": { "enum": ["consumed", "superseded"] },
    "consumed_at": { "type": "string", "format": "date-time" },
    "execution_correlation_id": { "type": "string" },
    "audit_correlation_id": { "type": "string" },
    "superseded_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
