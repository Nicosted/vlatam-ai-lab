{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-provider-evidence.schema.json",
  "title": "AI-82 primary-source provider evidence catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_record" }
    }
  },
  "$defs": {
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "provider_id",
        "model_id",
        "upstream_provider_id",
        "category",
        "status",
        "source",
        "applicability",
        "review",
        "expires_at",
        "finding",
        "limitations",
        "conflict_status",
        "conflicts_with",
        "evidence_hash"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "provider_id": { "enum": ["openrouter", "minimax-direct"] },
        "model_id": { "type": ["string", "null"], "minLength": 1 },
        "upstream_provider_id": { "type": ["string", "null"], "minLength": 1 },
        "category": {
          "enum": [
            "provider_identity",
            "model_identity",
            "model_lifecycle",
            "api_endpoint",
            "context_limits",
            "structured_outputs",
            "tool_calling",
            "multimodal",
            "token_accounting",
            "cached_reasoning_token_accounting",
            "pricing",
            "provider_routing",
            "rate_concurrency_limits",
            "processing_regions",
            "retention",
            "training_use",
            "zdr_status",
            "security_compliance",
            "normative_claim_extraction",
            "contractual_operational_restrictions"
          ]
        },
        "status": {
          "enum": ["accepted", "rejected", "conflicting", "unknown"]
        },
        "value": {},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "canonical_url",
            "publisher",
            "retrieved_at",
            "effective_at"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "canonical_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "publisher": { "enum": ["OpenRouter", "MiniMax"] },
            "retrieved_at": { "type": "string", "format": "date-time" },
            "effective_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "exact_scope",
            "route_mode",
            "route_provider_id"
          ],
          "properties": {
            "scope": {
              "enum": ["provider_wide", "model", "endpoint", "route"]
            },
            "exact_scope": { "type": "string", "minLength": 1 },
            "route_mode": { "enum": ["fixed", "variable", "not_applicable"] },
            "route_provider_id": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewed_at", "review_record_ref"],
          "properties": {
            "status": { "enum": ["reviewed_approved", "pending", "rejected"] },
            "reviewed_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "review_record_ref": { "type": ["string", "null"], "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "reviewed_approved" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "reviewed_at": { "type": "string" },
                  "review_record_ref": { "type": "string" }
                }
              }
            }
          ]
        },
        "expires_at": { "type": "string", "format": "date-time" },
        "finding": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "conflict_status": { "enum": ["none", "unresolved", "resolved"] },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          },
          "then": { "required": ["value"], "properties": { "value": {} } }
        },
        {
          "if": {
            "properties": { "conflict_status": { "const": "unresolved" } },
            "required": ["conflict_status"]
          },
          "then": {
            "properties": {
              "conflicts_with": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
