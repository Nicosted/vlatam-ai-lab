{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-scheduler-recovery-input.schema.json",
  "title": "Governed ARCA scheduler exact durable recovery input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration",
    "state_root",
    "run_id",
    "request_id",
    "lease_path",
    "journal_path",
    "request_path",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "identity", "sha256", "canonical_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "state_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "path"],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "lease_path": {
      "type": "string",
      "minLength": 1
    },
    "journal_path": {
      "type": "string",
      "minLength": 1
    },
    "request_path": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
