{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "export_id",
    "artifact_id",
    "source_id",
    "exported_at",
    "extracted_evidence",
    "schema_version"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "pattern": "^artifact--[a-z0-9_-]+--[a-z0-9_-]+--export$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact--[a-z0-9_-]+--[a-z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification_candidate": {
      "type": "object",
      "properties": {
        "ncm_code": { "type": "string" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "extracted_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "text"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim_type": {
            "enum": ["tariff", "intervention", "norm", "legal", "classification"]
          },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "affected_ncm": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "schema_version": { "type": "string" }
  },
  "additionalProperties": false
}
