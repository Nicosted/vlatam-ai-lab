{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-scheduler-run-journal.schema.json",
  "title": "Governed ARCA scheduler run journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "journal_sha256",
    "run_id",
    "request_id",
    "request_sha256",
    "configuration_sha256",
    "activation_sha256",
    "lease_sha256",
    "entries",
    "ai_131_evidence",
    "ai_132_evidence",
    "authority_outcome",
    "acquisition_authority_created",
    "export_authority_created",
    "import_authorized",
    "publication_authorized",
    "deployment_authorized",
    "database_write_authorized",
    "production_reliance_authorized",
    "downstream_scheduling_authorized",
    "vlatam_global_access_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lease_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "state", "timestamp", "evidence_sha256"],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "scheduled",
              "lease_acquired",
              "configuration_verified",
              "activation_verified",
              "observation_started",
              "acquisition_preflight_checked",
              "acquisition_execution_started",
              "acquisition_not_authorized",
              "acquisition_verified",
              "acquisition_blocked",
              "acquisition_unknown",
              "export_preflight_checked",
              "export_execution_started",
              "export_not_authorized",
              "export_verified",
              "export_blocked",
              "observation_recorded",
              "recovery_required",
              "safe_abort_before_authority",
              "authority_consumed_recovery",
              "unknown_delivery_manual_review",
              "lease_expired_recovery",
              "completed"
            ]
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
