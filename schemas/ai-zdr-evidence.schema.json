{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-zdr-evidence.schema.json",
  "title": "AI-73 ZDR verification evidence store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "description": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_record" }
    }
  },
  "$defs": {
    "classification": {
      "enum": ["public", "internal", "confidential", "regulated", "restricted"]
    },
    "retention_behavior": {
      "enum": [
        "none",
        "ephemeral_memory",
        "bounded_local_fixture",
        "provider_declared_bounded",
        "provider_unknown",
        "forbidden"
      ]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "schema_version",
        "profile_ids",
        "capability_ids",
        "classifications",
        "regions",
        "retention_behaviors",
        "training_use",
        "verification_source_type",
        "status",
        "verified_at",
        "expires_at",
        "evidence_hash",
        "human_review_status"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
        "profile_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/classification" }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "retention_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retention_behavior" }
        },
        "training_use": {
          "enum": [
            "contractually_prohibited_verified",
            "declared_not_used",
            "may_be_used",
            "unknown"
          ]
        },
        "verification_source_type": {
          "enum": ["provider_contract_review", "internal_security_review", "test_fixture"]
        },
        "status": {
          "enum": ["verified", "declared_unverified", "unsupported", "unknown"]
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{16,128}$" },
        "human_review_status": { "enum": ["reviewed_approved", "pending", "rejected"] }
      }
    }
  }
}
