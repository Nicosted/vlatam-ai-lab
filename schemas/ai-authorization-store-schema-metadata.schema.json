{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam.local/schemas/ai-authorization-store-schema-metadata.schema.json",
  "title": "AI-80 authorization store schema metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ddl_hash", "initialized_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "ddl_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "initialized_at": { "type": "string", "format": "date-time" }
  }
}
