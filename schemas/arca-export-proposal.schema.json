{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-export-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_sha256",
    "approved_artifact_id",
    "approved_artifact_sha256",
    "candidate_id",
    "candidate_sha256",
    "review_id",
    "review_sha256",
    "evaluation_id",
    "evaluation_sha256",
    "durable_store_configuration_sha256",
    "durable_store_event_id",
    "durable_store_event_sha256",
    "export_format",
    "export_format_version",
    "package_schema_version",
    "target_logical_consumer",
    "target_environment",
    "export_root_identity",
    "proposal_author_identity",
    "proposed_at",
    "export_window",
    "maximum_exports",
    "publication_authority",
    "deployment_authority",
    "production_authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "proposal_id": {
      "type": "string",
      "pattern": "^arca-export-proposal--[a-f0-9]{64}$"
    },
    "proposal_sha256": { "$ref": "#/$defs/hash" },
    "approved_artifact_id": {
      "type": "string",
      "pattern": "^approved-arca-artifact--[a-f0-9]{64}$"
    },
    "approved_artifact_sha256": { "$ref": "#/$defs/hash" },
    "candidate_id": {
      "type": "string",
      "pattern": "^arca-candidate--[a-f0-9]{64}$"
    },
    "candidate_sha256": { "$ref": "#/$defs/hash" },
    "review_id": { "type": "string", "pattern": "^arca-review--[a-f0-9]{64}$" },
    "review_sha256": { "$ref": "#/$defs/hash" },
    "evaluation_id": {
      "type": "string",
      "pattern": "^arca-review-evaluation--[a-f0-9]{64}$"
    },
    "evaluation_sha256": { "$ref": "#/$defs/hash" },
    "durable_store_configuration_sha256": { "$ref": "#/$defs/hash" },
    "durable_store_event_id": {
      "type": "string",
      "pattern": "^arca-store-event--[a-f0-9]{64}$"
    },
    "durable_store_event_sha256": { "$ref": "#/$defs/hash" },
    "export_format": { "const": "vlatam-arca-approved-tariff-json" },
    "export_format_version": { "const": "1.0.0" },
    "package_schema_version": { "const": "1.0.0" },
    "target_logical_consumer": { "const": "vlatam-global" },
    "target_environment": { "const": "handoff_only" },
    "export_root_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_author_identity": { "$ref": "#/$defs/human" },
    "proposed_at": { "$ref": "#/$defs/time" },
    "export_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at"],
      "properties": {
        "starts_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" }
      }
    },
    "maximum_exports": { "const": 1 },
    "publication_authority": { "const": false },
    "deployment_authority": { "const": false },
    "production_authority": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "human": { "type": "string", "pattern": "^human:[a-z0-9][a-z0-9._@-]*$" },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
