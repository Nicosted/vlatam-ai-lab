{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-openrouter-sandbox-activation-review.schema.json",
  "title": "Governed OpenRouter sandbox activation human review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_contract_version",
    "review_id",
    "review_version",
    "canonicalization_version",
    "lifecycle",
    "scope",
    "created_by",
    "created_at",
    "expires_at",
    "superseded_by",
    "candidate",
    "artifact_bindings",
    "ceilings",
    "routing_acknowledgment",
    "decisions",
    "operational_ownership",
    "secret_management_plan",
    "allowed_data",
    "downstream_restrictions",
    "execution_authorized",
    "secret_access_allowed",
    "runtime_enabled",
    "provider_call_performed",
    "review_hash"
  ],
  "properties": {
    "review_contract_version": { "const": "1.0.0" },
    "review_id": { "$ref": "#/$defs/id" },
    "review_version": { "$ref": "#/$defs/semver" },
    "canonicalization_version": { "const": "registry-json-v1" },
    "lifecycle": {
      "enum": ["pending", "approved", "rejected", "expired", "superseded"]
    },
    "scope": { "const": "one_synthetic_gold_case_sandbox_activation" },
    "created_by": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/date_time" },
    "expires_at": { "$ref": "#/$defs/date_time" },
    "superseded_by": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "openrouter_model_id",
        "intended_upstream_provider_id",
        "upstream_model_id",
        "model_registry_entry_id",
        "route_id",
        "route_record_id",
        "capability_id",
        "execution_profile_id",
        "execution_profile_contract_version",
        "adapter_config_id"
      ],
      "properties": {
        "provider_id": { "const": "openrouter" },
        "openrouter_model_id": { "const": "minimax/minimax-m2.7" },
        "intended_upstream_provider_id": { "const": "minimax" },
        "upstream_model_id": { "type": ["string", "null"] },
        "model_registry_entry_id": {
          "const": "openrouter.minimax-m2.7.variable.v1"
        },
        "route_id": { "const": "openrouter.minimax-m2.7.variable" },
        "route_record_id": {
          "const": "openrouter.minimax-m2.7.variable-route.v1"
        },
        "capability_id": { "const": "evidence.extraction.normative_claims" },
        "execution_profile_id": {
          "const": "openrouter.minimax-m2.7.normative-extraction.candidate"
        },
        "execution_profile_contract_version": { "$ref": "#/$defs/semver" },
        "adapter_config_id": {
          "const": "openrouter.disabled-adapter-config.v1"
        }
      }
    },
    "artifact_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness_dossier",
        "external_evidence_pack",
        "sandbox_proposal",
        "runtime_configuration",
        "execution_profile",
        "model_registry_entry",
        "route_record",
        "pricing_policy",
        "privacy_zdr_evidence",
        "gold_case",
        "first_run_fixture"
      ],
      "properties": {
        "readiness_dossier": { "$ref": "#/$defs/artifact_binding" },
        "external_evidence_pack": { "$ref": "#/$defs/artifact_binding" },
        "sandbox_proposal": { "$ref": "#/$defs/artifact_binding" },
        "runtime_configuration": { "$ref": "#/$defs/artifact_binding" },
        "execution_profile": { "$ref": "#/$defs/artifact_binding" },
        "model_registry_entry": { "$ref": "#/$defs/artifact_binding" },
        "route_record": { "$ref": "#/$defs/artifact_binding" },
        "pricing_policy": { "$ref": "#/$defs/resolvable_binding" },
        "privacy_zdr_evidence": { "$ref": "#/$defs/resolvable_binding" },
        "gold_case": { "$ref": "#/$defs/artifact_binding" },
        "first_run_fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_id", "fixture_hash", "classification"],
          "properties": {
            "fixture_id": { "$ref": "#/$defs/id" },
            "fixture_hash": { "$ref": "#/$defs/hash" },
            "classification": { "const": "synthetic" }
          }
        }
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_requests",
        "maximum_input_tokens_per_request",
        "maximum_output_tokens_per_request",
        "timeout_ms",
        "automatic_retries",
        "fallback_enabled",
        "maximum_total_spend_usd"
      ],
      "properties": {
        "maximum_requests": { "const": 1 },
        "maximum_input_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        },
        "maximum_output_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "automatic_retries": { "const": 0 },
        "fallback_enabled": { "const": false },
        "maximum_total_spend_usd": {
          "type": "string",
          "pattern": "^(0\\.0[1-5])$"
        }
      }
    },
    "routing_acknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_upstream_route_status", "limitations_acknowledged"],
      "properties": {
        "exact_upstream_route_status": { "enum": ["unresolved", "verified"] },
        "limitations_acknowledged": { "type": "boolean" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_review", "activation_approval"],
      "properties": {
        "evidence_review": { "$ref": "#/$defs/human_decision" },
        "activation_approval": { "$ref": "#/$defs/human_decision" }
      }
    },
    "operational_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_switch_owner", "incident_owner"],
      "properties": {
        "kill_switch_owner": { "$ref": "#/$defs/ownership" },
        "incident_owner": { "$ref": "#/$defs/ownership" }
      }
    },
    "secret_management_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference",
        "storage",
        "repository_storage_prohibited",
        "secret_reference_name"
      ],
      "properties": {
        "status": { "const": "defined" },
        "reference": { "type": "string", "minLength": 1 },
        "storage": {
          "const": "local_environment_variable_at_final_boundary"
        },
        "repository_storage_prohibited": { "const": true },
        "secret_reference_name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        }
      }
    },
    "allowed_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "customer_data_allowed",
        "personal_data_allowed",
        "production_documents_allowed"
      ],
      "properties": {
        "classification": { "const": "synthetic" },
        "customer_data_allowed": { "const": false },
        "personal_data_allowed": { "const": false },
        "production_documents_allowed": { "const": false }
      }
    },
    "downstream_restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_reliance_allowed",
        "automatic_downstream_publication_allowed",
        "human_review_required",
        "outputs_classification"
      ],
      "properties": {
        "legal_reliance_allowed": { "const": false },
        "automatic_downstream_publication_allowed": { "const": false },
        "human_review_required": { "const": true },
        "outputs_classification": { "const": "experimental" }
      }
    },
    "execution_authorized": { "const": false },
    "secret_access_allowed": { "const": false },
    "runtime_enabled": { "const": false },
    "provider_call_performed": { "const": false },
    "review_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "human_identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "resolvable_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id", "hash"],
      "properties": {
        "status": { "enum": ["resolved", "unresolved"] },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } } },
          "then": {
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "hash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unresolved" } } },
          "then": {
            "properties": { "id": { "const": null }, "hash": { "const": null } }
          }
        }
      ]
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewer_role",
        "decision",
        "reason",
        "decided_at",
        "reviewed_hashes"
      ],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewer_id": {
          "oneOf": [{ "$ref": "#/$defs/human_identity" }, { "type": "null" }]
        },
        "reviewer_role": {
          "enum": ["evidence_reviewer", "sandbox_activation_approver"]
        },
        "decision": { "enum": ["approve", "reject", null] },
        "reason": { "type": ["string", "null"] },
        "decided_at": {
          "oneOf": [{ "$ref": "#/$defs/date_time" }, { "type": "null" }]
        },
        "reviewed_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dossier_hash",
            "evidence_pack_hash",
            "proposal_hash",
            "gold_case_hash",
            "runtime_configuration_hash"
          ],
          "properties": {
            "dossier_hash": {
              "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
            },
            "evidence_pack_hash": {
              "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
            },
            "proposal_hash": {
              "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
            },
            "gold_case_hash": {
              "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
            },
            "runtime_configuration_hash": {
              "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "reviewer_id": { "const": null },
              "decision": { "const": null },
              "decided_at": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["approved", "rejected"] } }
          },
          "then": {
            "properties": {
              "reviewer_id": { "$ref": "#/$defs/human_identity" },
              "decision": { "enum": ["approve", "reject"] },
              "reason": { "type": "string", "minLength": 8 },
              "decided_at": { "$ref": "#/$defs/date_time" }
            }
          }
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity", "role"],
      "properties": {
        "status": { "enum": ["unassigned", "assigned"] },
        "identity": {
          "oneOf": [{ "$ref": "#/$defs/human_identity" }, { "type": "null" }]
        },
        "role": { "enum": ["kill_switch_owner", "incident_owner"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unassigned" } } },
          "then": { "properties": { "identity": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "const": "assigned" } } },
          "then": {
            "properties": { "identity": { "$ref": "#/$defs/human_identity" } }
          }
        }
      ]
    }
  }
}
