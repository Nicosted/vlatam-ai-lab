    "provenance":{"type":"object","additionalProperties":false,"required":["provenance_id","authority","jurisdiction","source_ref","snapshot_version","accessed_at"],"properties":{"provenance_id":{"$ref":"#/$defs/id"},"authority":{"type":"string","minLength":1},"jurisdiction":{"type":"string","minLength":1},"source_ref":{"type":"string","minLength":1},"snapshot_version":{"type":"string","minLength":1},"accessed_at":{"$ref":"#/$defs/date"},"effective_from":{"$ref":"#/$defs/date"},"effective_to":{"$ref":"#/$defs/date"}}},
