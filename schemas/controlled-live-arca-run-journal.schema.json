{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/controlled-live-arca-run-journal.schema.json",
  "title": "Controlled live ARCA run crash journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_type",
    "journal_sha256",
    "run_id",
    "run_sha256",
    "proposal_id",
    "proposal_sha256",
    "authorization_id",
    "authorization_sha256",
    "authorization_consumption_id",
    "requested_url",
    "source_identity",
    "attempt_number",
    "attempt_id",
    "transport_attempt_id",
    "lifecycle",
    "delivery_status",
    "created_at",
    "updated_at",
    "acquisition_record_id",
    "acquisition_record_sha256",
    "candidate_id",
    "candidate_sha256",
    "durable_store_event_id",
    "durable_store_event_sha256",
    "export_authorized",
    "publication_authorized",
    "production_reliance_authorized",
    "scheduler_authorized",
    "deployment_authorized",
    "vlatam_global_access_authorized"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "journal_type": { "const": "controlled_live_arca_run_journal" },
    "journal_sha256": { "$ref": "#/$defs/hash" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_sha256": { "$ref": "#/$defs/hash" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "proposal_sha256": { "$ref": "#/$defs/hash" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "authorization_sha256": { "$ref": "#/$defs/hash" },
    "authorization_consumption_id": { "type": "string", "minLength": 1 },
    "requested_url": { "type": "string", "format": "uri" },
    "source_identity": { "const": "ar-arca-arancel-integrado" },
    "attempt_number": { "const": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "transport_attempt_id": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "enum": [
        "proposed",
        "authorized",
        "authorization_consumed",
        "acquisition_started",
        "acquisition_succeeded",
        "acquisition_failed",
        "ingestion_succeeded",
        "ingestion_failed",
        "candidate_persisted",
        "completed",
        "recovery_required"
      ]
    },
    "delivery_status": {
      "enum": ["not_started", "unknown", "completed", "failed"]
    },
    "created_at": { "$ref": "#/$defs/time" },
    "updated_at": { "$ref": "#/$defs/time" },
    "acquisition_record_id": { "type": ["string", "null"] },
    "acquisition_record_sha256": { "$ref": "#/$defs/nullableHash" },
    "candidate_id": { "type": ["string", "null"] },
    "candidate_sha256": { "$ref": "#/$defs/nullableHash" },
    "durable_store_event_id": { "type": ["string", "null"] },
    "durable_store_event_sha256": { "$ref": "#/$defs/nullableHash" },
    "export_authorized": { "const": false },
    "publication_authorized": { "const": false },
    "production_reliance_authorized": { "const": false },
    "scheduler_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "vlatam_global_access_authorized": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
