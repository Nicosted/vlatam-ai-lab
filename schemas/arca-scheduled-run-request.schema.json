{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-scheduled-run-request.schema.json",
  "title": "Governed ARCA scheduled run request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "configuration_id",
    "configuration_sha256",
    "activation_id",
    "activation_sha256",
    "mode",
    "scheduled_for",
    "created_at",
    "created_by",
    "ai_131_proposal_path",
    "ai_131_authorization_path",
    "ai_132_proposal_path",
    "ai_132_authorization_path",
    "acquisition_authority_created",
    "export_authority_created",
    "import_authorized",
    "publication_authorized",
    "deployment_authorized",
    "database_write_authorized",
    "production_reliance_authorized",
    "downstream_scheduling_authorized",
    "vlatam_global_access_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "activation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": ["observe", "run_once"]
    },
    "scheduled_for": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^human:[a-z0-9][a-z0-9._@-]*$"
    },
    "ai_131_proposal_path": {
      "type": ["string", "null"]
    },
    "ai_131_authorization_path": {
      "type": ["string", "null"]
    },
    "ai_132_proposal_path": {
      "type": ["string", "null"]
    },
    "ai_132_authorization_path": {
      "type": ["string", "null"]
    },
    "acquisition_authority_created": {
      "const": false
    },
    "export_authority_created": {
      "const": false
    },
    "import_authorized": {
      "const": false
    },
    "publication_authorized": {
      "const": false
    },
    "deployment_authorized": {
      "const": false
    },
    "database_write_authorized": {
      "const": false
    },
    "production_reliance_authorized": {
      "const": false
    },
    "downstream_scheduling_authorized": {
      "const": false
    },
    "vlatam_global_access_authorized": {
      "const": false
    }
  }
}
