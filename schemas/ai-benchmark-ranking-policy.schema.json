{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vlatam.local/schemas/ai-benchmark-ranking-policy.schema.json","title":"AI benchmark ranking policy v1","type":"object","additionalProperties":false,"required":["schema_version","policy_id","version","mandatory_gates","tie_breakers"],"properties":{"schema_version":{"const":"1.0.0"},"policy_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"mandatory_gates":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["gate_id","type"],"properties":{"gate_id":{"type":"string"},"type":{"enum":["coverage_complete","no_blocked_or_rejected","minimum_score","dimension_perfect"]},"minimum_score":{"$ref":"#/$defs/ratio"},"dimension_type":{"type":"string"}}}},"tie_breakers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["quality","abstention","reliability","cost","latency"]}}},"$defs":{"ratio":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":1}}}}}
