{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-pricing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prices", "legacy_prices"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "prices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pricingEntry" }
    },
    "legacy_prices": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacyEntry" }
    }
  },
  "$defs": {
    "unsigned": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 4096
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/$defs/unsigned" },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 4096
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "amount",
        "currency",
        "billing_unit",
        "usage_category"
      ],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "amount": { "$ref": "#/$defs/rational" },
        "currency": { "const": "USD" },
        "billing_unit": { "enum": ["token", "million_tokens", "request"] },
        "usage_category": {
          "enum": [
            "input",
            "output",
            "cache_read",
            "cache_write",
            "reasoning",
            "request"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "usage_category": { "const": "request" } },
            "required": ["usage_category"]
          },
          "then": { "properties": { "billing_unit": { "const": "request" } } },
          "else": {
            "properties": {
              "billing_unit": { "enum": ["token", "million_tokens"] }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_hash",
        "evidence_version",
        "reviewed_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "reviewed_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date-time" },
        "status": {
          "enum": ["fixture", "verified", "declared_unverified", "unknown"]
        }
      }
    },
    "pricingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pricing_id",
        "schema_version",
        "pricing_contract_version",
        "provider_id",
        "model_id",
        "currency",
        "rates",
        "effective_from",
        "permitted_execution_modes",
        "evidence"
      ],
      "properties": {
        "pricing_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "schema_version": { "const": "2.0.0" },
        "pricing_contract_version": { "const": "1.0.0" },
        "provider_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "currency": { "const": "USD" },
        "rates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/rate" }
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "permitted_execution_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["replay", "live"] }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "legacyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pricing_id",
        "schema_version",
        "provider_id",
        "model_id",
        "currency",
        "input_price_minor",
        "output_price_minor",
        "pricing_denominator_tokens",
        "effective_from",
        "evidence_status",
        "permitted_execution_modes",
        "evidence_ref"
      ],
      "properties": {
        "pricing_id": { "type": "string" },
        "schema_version": { "const": "1.0.0" },
        "provider_id": { "type": "string" },
        "model_id": { "type": "string" },
        "currency": { "type": "string" },
        "input_price_minor": { "type": "integer" },
        "output_price_minor": { "type": "integer" },
        "pricing_denominator_tokens": { "type": "integer" },
        "effective_from": { "type": "string" },
        "evidence_status": { "type": "string" },
        "permitted_execution_modes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_ref": { "type": "string" }
      }
    }
  }
}
