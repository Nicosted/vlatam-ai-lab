{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-scheduler-kill-switch.schema.json",
  "title": "Governed ARCA scheduler kill switch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kill_switch_id",
    "kill_switch_sha256",
    "state",
    "observation_blocked",
    "execution_blocked",
    "reviewed_artifact_id",
    "reviewed_by",
    "reviewed_at",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kill_switch_id": {
      "const": "governed-arca-scheduler"
    },
    "kill_switch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": ["active", "disabled"]
    },
    "observation_blocked": {
      "type": "boolean"
    },
    "execution_blocked": {
      "type": "boolean"
    },
    "reviewed_artifact_id": {
      "type": ["string", "null"]
    },
    "reviewed_by": {
      "type": ["string", "null"]
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
