{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-regression-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "regression_decision_id",
    "capability_id",
    "candidate_id",
    "observed_state",
    "decision",
    "decided_by_role",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "regression_decision_id": {
      "$ref": "ai-tournament-common.schema.json#/$defs/id"
    },
    "capability_id": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
    "candidate_id": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
    "observed_state": {
      "$ref": "ai-tournament-common.schema.json#/$defs/lifecycle"
    },
    "decision": { "enum": ["degrade", "suspend", "block", "retain"] },
    "decided_by_role": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
      "uniqueItems": true
    }
  }
}
