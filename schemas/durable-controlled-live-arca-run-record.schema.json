{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/durable-controlled-live-arca-run-record.schema.json",
  "title": "Durable controlled live ARCA run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "record_type",
    "record_sha256",
    "run_id",
    "proposal_id",
    "proposal_sha256",
    "authorization_id",
    "authorization_sha256",
    "requested_url",
    "expected_source_identity",
    "acquisition_policy_sha256",
    "lifecycle",
    "outcome",
    "result_timestamp",
    "network_calls_attempted",
    "network_calls_completed",
    "authorization_consumed",
    "acquisition_bytes_persisted",
    "candidate_created",
    "candidate_durably_persisted",
    "acquisition_record_id",
    "acquisition_record_sha256",
    "candidate_id",
    "candidate_sha256",
    "durable_store_event_id",
    "durable_store_event_sha256",
    "details",
    "review_required",
    "approval",
    "approved_artifact_created",
    "export_authorized",
    "publication_authorized",
    "production_reliance_authorized",
    "scheduler_authorized",
    "deployment_authorized",
    "vlatam_global_access_authorized"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_type": { "const": "controlled_live_arca_run_result" },
    "record_type": { "const": "durable_controlled_live_arca_run_record" },
    "record_sha256": { "$ref": "#/$defs/hash" },
    "run_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string" },
    "proposal_sha256": { "$ref": "#/$defs/hash" },
    "authorization_id": { "type": "string" },
    "authorization_sha256": { "$ref": "#/$defs/hash" },
    "requested_url": { "type": "string", "format": "uri" },
    "expected_source_identity": { "const": "ar-arca-arancel-integrado" },
    "acquisition_policy_sha256": { "$ref": "#/$defs/hash" },
    "lifecycle": { "const": "completed" },
    "outcome": { "const": "completed" },
    "result_timestamp": { "$ref": "#/$defs/time" },
    "network_calls_attempted": { "const": 1 },
    "network_calls_completed": { "const": 1 },
    "authorization_consumed": { "const": true },
    "acquisition_bytes_persisted": { "const": true },
    "candidate_created": { "const": true },
    "candidate_durably_persisted": { "const": true },
    "acquisition_record_id": { "type": "string" },
    "acquisition_record_sha256": { "$ref": "#/$defs/hash" },
    "candidate_id": { "type": "string" },
    "candidate_sha256": { "$ref": "#/$defs/hash" },
    "durable_store_event_id": { "type": ["string", "null"] },
    "durable_store_event_sha256": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
    },
    "details": { "type": "array", "items": { "type": "string" } },
    "review_required": { "const": true },
    "approval": { "const": false },
    "approved_artifact_created": { "const": false },
    "export_authorized": { "const": false },
    "publication_authorized": { "const": false },
    "production_reliance_authorized": { "const": false },
    "scheduler_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "vlatam_global_access_authorized": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
