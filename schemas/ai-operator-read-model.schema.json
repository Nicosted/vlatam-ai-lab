{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-operator-read-model.schema.json",
  "title": "AI LAB Operator Read Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "system_summary",
    "providers",
    "models",
    "routes",
    "execution_profiles",
    "governed_candidates",
    "readiness",
    "evidence",
    "sandbox_proposals",
    "runtime_preflight",
    "activation_review",
    "gold_case_state",
    "authorization",
    "consumption",
    "gateway_adapter_state",
    "budget_state",
    "kill_switch_state",
    "secret_configuration_status",
    "blockers",
    "required_human_actions",
    "validation_evidence_metadata",
    "audit_references",
    "arca_candidate_review",
    "arca_approved_artifact",
    "arca_regulatory_batch",
    "arca_read_only_library",
    "tournament"
  ],
  "properties": {
    "contract_version": { "const": "1.10.0" },
    "system_summary": {
      "type": "object",
      "required": [
        "overall_status",
        "total_providers",
        "enabled_providers",
        "blocked_providers",
        "disabled_adapters",
        "blocked_routes",
        "pending_approvals",
        "active_blockers",
        "execution_authorized_count",
        "last_evaluated_at",
        "read_model_contract_version",
        "read_model_hash"
      ],
      "properties": {
        "overall_status": {
          "enum": ["healthy", "attention_required", "blocked", "invalid_state"]
        },
        "total_providers": { "type": "integer", "minimum": 0 },
        "enabled_providers": { "type": "integer", "minimum": 0 },
        "blocked_providers": { "type": "integer", "minimum": 0 },
        "disabled_adapters": { "type": "integer", "minimum": 0 },
        "blocked_routes": { "type": "integer", "minimum": 0 },
        "pending_approvals": { "type": "integer", "minimum": 0 },
        "active_blockers": { "type": "integer", "minimum": 0 },
        "execution_authorized_count": { "type": "integer", "minimum": 0 },
        "last_evaluated_at": { "type": "string", "format": "date-time" },
        "read_model_contract_version": { "const": "1.10.0" },
        "read_model_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "providers": { "type": "array", "items": { "type": "object" } },
    "models": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "routes": { "type": "array", "items": { "type": "object" } },
    "execution_profiles": { "type": "array", "items": { "type": "object" } },
    "governed_candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "model",
          "route",
          "profile",
          "readiness",
          "evidence",
          "proposal",
          "runtime_preflight",
          "activation_review",
          "authorization",
          "consumption",
          "adapter_gateway_transport_state",
          "blockers",
          "blocker_count",
          "next_governed_action"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "model": { "type": "object" },
          "route": { "type": "object" },
          "profile": { "type": "object" },
          "readiness": { "type": "string" },
          "evidence": { "type": "string" },
          "proposal": { "type": "string" },
          "runtime_preflight": { "type": "string" },
          "activation_review": { "type": "string" },
          "authorization": { "type": "string" },
          "consumption": { "type": "string" },
          "adapter_gateway_transport_state": { "type": "object" },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "blocker_count": { "type": "integer", "minimum": 0 },
          "next_governed_action": { "type": "string" },
          "conformance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "cases_attempted",
              "cases_passed",
              "schema_pass_rate",
              "provider_routing_match",
              "zdr_evidence_status",
              "budget_reconciliation",
              "retries",
              "duplicate_consumption_result",
              "blockers",
              "independent_review_required",
              "activation_prohibited",
              "kill_switch_state"
            ],
            "properties": {
              "status": {
                "enum": ["prepared_not_executed", "passed", "failed", "blocked"]
              },
              "cases_attempted": { "type": "integer", "minimum": 0 },
              "cases_passed": { "type": "integer", "minimum": 0 },
              "schema_pass_rate": { "type": ["string", "null"] },
              "provider_routing_match": {
                "enum": [
                  "not_attempted",
                  "matched",
                  "mismatched",
                  "unavailable"
                ]
              },
              "zdr_evidence_status": {
                "enum": [
                  "metadata_only_runtime_pending",
                  "runtime_complete",
                  "runtime_incomplete"
                ]
              },
              "budget_reconciliation": {
                "enum": [
                  "not_attempted",
                  "reconciled",
                  "discrepant",
                  "incomplete"
                ]
              },
              "retries": { "type": "integer", "minimum": 0 },
              "duplicate_consumption_result": {
                "enum": ["not_attempted", "safe", "unsafe"]
              },
              "blockers": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "independent_review_required": { "const": true },
              "activation_prohibited": { "const": true },
              "kill_switch_state": { "const": "active" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": { "$ref": "#/$defs/evaluation" },
    "evidence": { "type": "object" },
    "sandbox_proposals": { "type": "array", "items": { "type": "object" } },
    "runtime_preflight": { "type": "object" },
    "activation_review": {
      "type": "object",
      "required": [
        "outcome",
        "reason_codes",
        "source_artifact_id",
        "source_artifact_hash",
        "version",
        "lifecycle",
        "scope",
        "expires_at",
        "pending_human_decisions",
        "evidence_review_status",
        "activation_approval_status",
        "kill_switch_owner_status",
        "incident_owner_status",
        "allowed_data_classification",
        "ceilings",
        "bound_artifacts",
        "next_governed_action"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "invalid_review",
            "blocked",
            "pending_human_review",
            "eligible_for_activation_configuration",
            "expired",
            "rejected"
          ]
        },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string" },
        "pending_human_decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_review_status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "activation_approval_status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "kill_switch_owner_status": { "enum": ["unassigned", "assigned"] },
        "incident_owner_status": { "enum": ["unassigned", "assigned"] },
        "ceilings": { "type": "object" },
        "bound_artifacts": {
          "type": "array",
          "items": { "type": "object" }
        },
        "next_governed_action": { "type": "string" }
      }
    },
    "gold_case_state": {
      "type": "object",
      "required": [
        "outcome",
        "reason_codes",
        "source_artifact_id",
        "source_artifact_hash",
        "version",
        "capability_id",
        "campaign_status",
        "acceptance_status"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "invalid_gold_case",
            "prepared_pending_acceptance",
            "accepted",
            "rejected"
          ]
        },
        "campaign_status": {
          "enum": ["prepared_not_executed", null]
        },
        "acceptance_status": {
          "enum": ["pending", "approved", "rejected", null]
        }
      }
    },
    "authorization": { "type": "object" },
    "consumption": { "type": "object" },
    "gateway_adapter_state": { "type": "object" },
    "budget_state": { "type": "object" },
    "kill_switch_state": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["active", "inactive", "missing", "unknown"] }
      },
      "additionalProperties": false
    },
    "secret_configuration_status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["not_configured", "configured_unknown", "not_required"]
        }
      },
      "additionalProperties": false
    },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "required_human_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "validation_evidence_metadata": { "type": "object" },
    "audit_references": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "arca_candidate_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_context",
        "candidate_artifact_id",
        "candidate_sha256",
        "acquisition_id",
        "source",
        "captured_at",
        "parser_id",
        "parser_version",
        "parsed_output_sha256",
        "tariff_line_count",
        "candidate_states",
        "review_lifecycle",
        "review_id",
        "review_sha256",
        "evaluation_outcome",
        "reviewer_present",
        "reviewer_identity",
        "decision_timestamp",
        "expires_at",
        "review_statement",
        "rejection_reason",
        "unresolved_findings_count",
        "findings",
        "separation_of_duties",
        "evaluation_id",
        "evaluation_sha256",
        "evaluated_at",
        "evaluation_reason_codes",
        "evaluation_bindings",
        "eligible_for_approved_artifact_building",
        "approved_artifact_created",
        "export_authorized",
        "publication_authorized",
        "production_reliance_authorized",
        "database_write_authorized",
        "network_call_authorized",
        "scheduler_authorized",
        "deployment_authorized",
        "vlatam_global_access_authorized",
        "execution_performed"
      ],
      "properties": {
        "source_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_source",
            "fixture_kind",
            "synthetic_candidate",
            "real_human_decision"
          ],
          "properties": {
            "projection_source": {
              "enum": ["repository-current", "synthetic_fixture"]
            },
            "fixture_kind": { "type": ["string", "null"] },
            "synthetic_candidate": { "type": "boolean" },
            "real_human_decision": { "enum": ["absent", "present"] }
          }
        },
        "candidate_artifact_id": { "type": ["string", "null"] },
        "candidate_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "acquisition_id": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "captured_at": { "type": ["string", "null"], "format": "date-time" },
        "parser_id": { "type": ["string", "null"] },
        "parser_version": { "type": ["string", "null"] },
        "parsed_output_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tariff_line_count": { "type": ["integer", "null"], "minimum": 0 },
        "candidate_states": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validation_status",
            "review_state",
            "approval_status",
            "publication_status"
          ],
          "properties": {
            "validation_status": { "type": ["string", "null"] },
            "review_state": { "type": ["string", "null"] },
            "approval_status": { "type": ["string", "null"] },
            "publication_status": { "type": ["string", "null"] }
          }
        },
        "review_lifecycle": { "type": "string" },
        "review_id": { "type": ["string", "null"] },
        "review_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluation_outcome": { "type": "string" },
        "reviewer_present": { "type": "boolean" },
        "reviewer_identity": { "type": ["string", "null"] },
        "decision_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "review_statement": { "type": ["string", "null"] },
        "rejection_reason": { "type": ["string", "null"] },
        "unresolved_findings_count": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "category",
              "finding_code",
              "description",
              "resolution_status"
            ],
            "properties": {
              "severity": { "type": "string" },
              "category": { "type": "string" },
              "finding_code": { "type": "string" },
              "description": { "type": "string" },
              "resolution_status": { "type": "string" }
            }
          }
        },
        "separation_of_duties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquisition_operator_identity",
            "parser_runtime_identity",
            "candidate_producer_identity",
            "evidence_reviewer_identity",
            "reviewer_independence_asserted"
          ],
          "properties": {
            "acquisition_operator_identity": { "type": ["string", "null"] },
            "parser_runtime_identity": { "type": ["string", "null"] },
            "candidate_producer_identity": { "type": ["string", "null"] },
            "evidence_reviewer_identity": { "type": ["string", "null"] },
            "reviewer_independence_asserted": { "type": "boolean" }
          }
        },
        "evaluation_id": { "type": "string" },
        "evaluation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "evaluation_reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluation_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_artifact_id",
            "candidate_sha256",
            "review_id",
            "review_sha256"
          ],
          "properties": {
            "candidate_artifact_id": { "type": ["string", "null"] },
            "candidate_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "review_id": { "type": ["string", "null"] },
            "review_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "eligible_for_approved_artifact_building": { "type": "boolean" },
        "approved_artifact_created": { "const": false },
        "export_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "production_reliance_authorized": { "const": false },
        "database_write_authorized": { "const": false },
        "network_call_authorized": { "const": false },
        "scheduler_authorized": { "const": false },
        "deployment_authorized": { "const": false },
        "vlatam_global_access_authorized": { "const": false },
        "execution_performed": { "const": false }
      }
    },
    "arca_approved_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "approved_artifact_id",
        "approved_artifact_sha256",
        "candidate_artifact_id",
        "candidate_sha256",
        "review_id",
        "review_sha256",
        "evaluation_id",
        "evaluation_sha256",
        "builder_identity",
        "build_timestamp",
        "export_status",
        "publication_status",
        "production_reliance",
        "vlatam_global_consumption",
        "export_authorized",
        "publication_authorized",
        "production_reliance_authorized",
        "database_write_authorized",
        "network_call_authorized",
        "vlatam_global_access_authorized"
      ],
      "properties": {
        "present": { "type": "boolean" },
        "approved_artifact_id": { "type": ["string", "null"] },
        "approved_artifact_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_artifact_id": { "type": ["string", "null"] },
        "candidate_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_id": { "type": ["string", "null"] },
        "review_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluation_id": { "type": ["string", "null"] },
        "evaluation_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "builder_identity": { "type": ["string", "null"] },
        "build_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "export_status": { "const": "not_exported" },
        "publication_status": { "const": "not_published" },
        "production_reliance": { "const": "not_authorized" },
        "vlatam_global_consumption": { "const": "not_authorized" },
        "export_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "production_reliance_authorized": { "const": false },
        "database_write_authorized": { "const": false },
        "network_call_authorized": { "const": false },
        "vlatam_global_access_authorized": { "const": false }
      }
    },
    "arca_regulatory_batch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "batch_id",
        "artifacts",
        "review_packages",
        "pending_count",
        "approved_count",
        "published_count",
        "scheduler_active",
        "runtime_arca_execution_available",
        "database_write_authorized",
        "publication_authorized",
        "legal_interpretation_performed"
      ],
      "properties": {
        "batch_id": { "const": "ar-arca-first-regulatory-batch-2026" },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        },
        "review_packages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        },
        "pending_count": { "const": 0 },
        "approved_count": { "const": 3 },
        "published_count": { "const": 3 },
        "scheduler_active": { "const": false },
        "runtime_arca_execution_available": { "const": false },
        "database_write_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "legal_interpretation_performed": { "const": false }
      }
    },
    "arca_read_only_library": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "library_id",
        "items",
        "human_decisions",
        "publication_records",
        "pending_real_regulations",
        "approved_real_regulations",
        "published_read_only_regulations",
        "model_execution_permitted",
        "runtime_arca_execution_available",
        "scheduler_active",
        "database_write_authorized",
        "external_side_effects_performed",
        "legal_interpretation_performed"
      ],
      "properties": {
        "library_id": { "const": "ar-arca-read-only-library-2026" },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        },
        "human_decisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        },
        "publication_records": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        },
        "pending_real_regulations": { "const": 0 },
        "approved_real_regulations": { "const": 3 },
        "published_read_only_regulations": { "const": 3 },
        "model_execution_permitted": { "const": false },
        "runtime_arca_execution_available": { "const": false },
        "scheduler_active": { "const": false },
        "database_write_authorized": { "const": false },
        "external_side_effects_performed": { "const": false },
        "legal_interpretation_performed": { "const": false }
      }
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_candidates",
        "runtime_evidence",
        "write_actions_available"
      ],
      "properties": {
        "write_actions_available": { "const": false },
        "runtime_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "evidence_freshness",
              "source_count",
              "immutable_source_count",
              "mutable_source_count",
              "unresolved_gaps",
              "privacy_blockers",
              "durability_confidence",
              "cost_accounting_confidence",
              "independent_review_required",
              "lifecycle_recommendation",
              "activation_prohibited",
              "kill_switch_state"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "evidence_freshness": {
                "enum": ["current", "expiring", "expired"]
              },
              "source_count": { "type": "integer", "minimum": 1 },
              "immutable_source_count": { "type": "integer", "minimum": 0 },
              "mutable_source_count": { "type": "integer", "minimum": 0 },
              "unresolved_gaps": { "type": "integer", "minimum": 0 },
              "privacy_blockers": { "type": "integer", "minimum": 0 },
              "durability_confidence": { "enum": ["low", "medium", "high"] },
              "cost_accounting_confidence": {
                "enum": ["low", "medium", "high"]
              },
              "independent_review_required": { "const": true },
              "lifecycle_recommendation": { "const": "remain_discovered" },
              "activation_prohibited": { "const": true },
              "kill_switch_state": { "const": "active" }
            }
          }
        },
        "registered_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "lifecycle_status",
              "benchmark_eligible",
              "latest_daily_result",
              "latest_weekly_review",
              "unresolved_blockers",
              "budget_state",
              "kill_switch_state",
              "promotion_recommendation",
              "human_decision_required"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "lifecycle_status": {
                "enum": [
                  "discovered",
                  "sandbox_only",
                  "benchmark_candidate",
                  "shadow",
                  "canary",
                  "approved",
                  "preferred",
                  "degraded",
                  "suspended",
                  "blocked"
                ]
              },
              "benchmark_eligible": { "type": "boolean" },
              "latest_daily_result": { "type": ["string", "null"] },
              "latest_weekly_review": { "type": ["string", "null"] },
              "unresolved_blockers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "budget_state": {
                "enum": ["disabled", "available", "exhausted"]
              },
              "kill_switch_state": { "enum": ["active", "inactive"] },
              "promotion_recommendation": {
                "enum": ["none", "defer", "promote", "regress"]
              },
              "human_decision_required": { "const": true }
            }
          }
        }
      }
    }
  },
