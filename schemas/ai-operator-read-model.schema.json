{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-operator-read-model.schema.json",
  "title": "AI LAB Operator Read Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "system_summary",
    "providers",
    "models",
    "routes",
    "execution_profiles",
    "governed_candidates",
    "readiness",
    "evidence",
    "sandbox_proposals",
    "runtime_preflight",
    "activation_review",
    "gold_case_state",
    "authorization",
    "consumption",
    "gateway_adapter_state",
    "budget_state",
    "kill_switch_state",
    "secret_configuration_status",
    "blockers",
    "required_human_actions",
    "validation_evidence_metadata",
    "audit_references",
    "arca_candidate_review",
    "tournament"
  ],
  "properties": {
    "contract_version": { "const": "1.5.0" },
    "system_summary": {
      "type": "object",
      "required": [
        "overall_status",
        "total_providers",
        "enabled_providers",
        "blocked_providers",
        "disabled_adapters",
        "blocked_routes",
        "pending_approvals",
        "active_blockers",
        "execution_authorized_count",
        "last_evaluated_at",
        "read_model_contract_version",
        "read_model_hash"
      ],
      "properties": {
        "overall_status": {
          "enum": ["healthy", "attention_required", "blocked", "invalid_state"]
        },
        "total_providers": { "type": "integer", "minimum": 0 },
        "enabled_providers": { "type": "integer", "minimum": 0 },
        "blocked_providers": { "type": "integer", "minimum": 0 },
        "disabled_adapters": { "type": "integer", "minimum": 0 },
        "blocked_routes": { "type": "integer", "minimum": 0 },
        "pending_approvals": { "type": "integer", "minimum": 0 },
        "active_blockers": { "type": "integer", "minimum": 0 },
        "execution_authorized_count": { "type": "integer", "minimum": 0 },
        "last_evaluated_at": { "type": "string", "format": "date-time" },
        "read_model_contract_version": { "const": "1.5.0" },
        "read_model_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "providers": { "type": "array", "items": { "type": "object" } },
    "models": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "routes": { "type": "array", "items": { "type": "object" } },
    "execution_profiles": { "type": "array", "items": { "type": "object" } },
    "governed_candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "model",
          "route",
          "profile",
          "readiness",
          "evidence",
          "proposal",
          "runtime_preflight",
          "activation_review",
          "authorization",
          "consumption",
          "adapter_gateway_transport_state",
          "blockers",
          "blocker_count",
          "next_governed_action"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "model": { "type": "object" },
          "route": { "type": "object" },
          "profile": { "type": "object" },
          "readiness": { "type": "string" },
          "evidence": { "type": "string" },
          "proposal": { "type": "string" },
          "runtime_preflight": { "type": "string" },
          "activation_review": { "type": "string" },
          "authorization": { "type": "string" },
          "consumption": { "type": "string" },
          "adapter_gateway_transport_state": { "type": "object" },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "blocker_count": { "type": "integer", "minimum": 0 },
          "next_governed_action": { "type": "string" },
          "conformance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "cases_attempted",
              "cases_passed",
              "schema_pass_rate",
              "provider_routing_match",
              "zdr_evidence_status",
              "budget_reconciliation",
              "retries",
              "duplicate_consumption_result",
              "blockers",
              "independent_review_required",
              "activation_prohibited",
              "kill_switch_state"
            ],
            "properties": {
              "status": {
                "enum": ["prepared_not_executed", "passed", "failed", "blocked"]
              },
              "cases_attempted": { "type": "integer", "minimum": 0 },
              "cases_passed": { "type": "integer", "minimum": 0 },
              "schema_pass_rate": { "type": ["string", "null"] },
              "provider_routing_match": {
                "enum": [
                  "not_attempted",
                  "matched",
                  "mismatched",
                  "unavailable"
                ]
              },
              "zdr_evidence_status": {
                "enum": [
                  "metadata_only_runtime_pending",
                  "runtime_complete",
                  "runtime_incomplete"
                ]
              },
              "budget_reconciliation": {
                "enum": [
                  "not_attempted",
                  "reconciled",
                  "discrepant",
                  "incomplete"
                ]
              },
              "retries": { "type": "integer", "minimum": 0 },
              "duplicate_consumption_result": {
                "enum": ["not_attempted", "safe", "unsafe"]
              },
              "blockers": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "independent_review_required": { "const": true },
              "activation_prohibited": { "const": true },
              "kill_switch_state": { "const": "active" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": { "$ref": "#/$defs/evaluation" },
    "evidence": { "type": "object" },
    "sandbox_proposals": { "type": "array", "items": { "type": "object" } },
    "runtime_preflight": { "type": "object" },
    "activation_review": {
      "type": "object",
      "required": [
        "outcome",
        "reason_codes",
        "source_artifact_id",
        "source_artifact_hash",
        "version",
        "lifecycle",
        "scope",
        "expires_at",
        "pending_human_decisions",
        "evidence_review_status",
        "activation_approval_status",
        "kill_switch_owner_status",
        "incident_owner_status",
        "allowed_data_classification",
        "ceilings",
        "bound_artifacts",
        "next_governed_action"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "invalid_review",
            "blocked",
            "pending_human_review",
            "eligible_for_activation_configuration",
            "expired",
            "rejected"
          ]
        },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string" },
        "pending_human_decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_review_status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "activation_approval_status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "kill_switch_owner_status": { "enum": ["unassigned", "assigned"] },
        "incident_owner_status": { "enum": ["unassigned", "assigned"] },
        "ceilings": { "type": "object" },
        "bound_artifacts": {
          "type": "array",
          "items": { "type": "object" }
        },
        "next_governed_action": { "type": "string" }
      }
    },
    "gold_case_state": {
      "type": "object",
      "required": [
        "outcome",
        "reason_codes",
        "source_artifact_id",
        "source_artifact_hash",
        "version",
        "capability_id",
        "campaign_status",
        "acceptance_status"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "invalid_gold_case",
            "prepared_pending_acceptance",
            "accepted",
            "rejected"
          ]
        },
        "campaign_status": {
          "enum": ["prepared_not_executed", null]
        },
        "acceptance_status": {
          "enum": ["pending", "approved", "rejected", null]
        }
      }
    },
    "authorization": { "type": "object" },
    "consumption": { "type": "object" },
    "gateway_adapter_state": { "type": "object" },
    "budget_state": { "type": "object" },
    "kill_switch_state": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["active", "inactive", "missing", "unknown"] }
      },
      "additionalProperties": false
    },
    "secret_configuration_status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["not_configured", "configured_unknown", "not_required"]
        }
      },
      "additionalProperties": false
    },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "required_human_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "validation_evidence_metadata": { "type": "object" },
    "audit_references": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "arca_candidate_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_artifact_id",
        "candidate_sha256",
        "review_lifecycle",
        "evaluation_outcome",
        "reviewer_present",
        "expires_at",
        "unresolved_findings_count",
        "eligible_for_approved_artifact_building",
        "export_authorized",
        "publication_authorized"
      ],
      "properties": {
        "candidate_artifact_id": { "type": ["string", "null"] },
        "candidate_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_lifecycle": { "type": "string" },
        "evaluation_outcome": { "type": "string" },
        "reviewer_present": { "type": "boolean" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "unresolved_findings_count": { "type": "integer", "minimum": 0 },
        "eligible_for_approved_artifact_building": { "type": "boolean" },
        "export_authorized": { "const": false },
        "publication_authorized": { "const": false }
      }
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_candidates",
        "runtime_evidence",
        "write_actions_available"
      ],
      "properties": {
        "write_actions_available": { "const": false },
        "runtime_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "evidence_freshness",
              "source_count",
              "immutable_source_count",
              "mutable_source_count",
              "unresolved_gaps",
              "privacy_blockers",
              "durability_confidence",
              "cost_accounting_confidence",
              "independent_review_required",
              "lifecycle_recommendation",
              "activation_prohibited",
              "kill_switch_state"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "evidence_freshness": {
                "enum": ["current", "expiring", "expired"]
              },
              "source_count": { "type": "integer", "minimum": 1 },
              "immutable_source_count": { "type": "integer", "minimum": 0 },
              "mutable_source_count": { "type": "integer", "minimum": 0 },
              "unresolved_gaps": { "type": "integer", "minimum": 0 },
              "privacy_blockers": { "type": "integer", "minimum": 0 },
              "durability_confidence": { "enum": ["low", "medium", "high"] },
              "cost_accounting_confidence": {
                "enum": ["low", "medium", "high"]
              },
              "independent_review_required": { "const": true },
              "lifecycle_recommendation": { "const": "remain_discovered" },
              "activation_prohibited": { "const": true },
              "kill_switch_state": { "const": "active" }
            }
          }
        },
        "registered_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "lifecycle_status",
              "benchmark_eligible",
              "latest_daily_result",
              "latest_weekly_review",
              "unresolved_blockers",
              "budget_state",
              "kill_switch_state",
              "promotion_recommendation",
              "human_decision_required"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "lifecycle_status": {
                "enum": [
                  "discovered",
                  "sandbox_only",
                  "benchmark_candidate",
                  "shadow",
                  "canary",
                  "approved",
                  "preferred",
                  "degraded",
                  "suspended",
                  "blocked"
                ]
              },
              "benchmark_eligible": { "type": "boolean" },
              "latest_daily_result": { "type": ["string", "null"] },
              "latest_weekly_review": { "type": ["string", "null"] },
              "unresolved_blockers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "budget_state": {
                "enum": ["disabled", "available", "exhausted"]
              },
              "kill_switch_state": { "enum": ["active", "inactive"] },
              "promotion_recommendation": {
                "enum": ["none", "defer", "promote", "regress"]
              },
              "human_decision_required": { "const": true }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "entry_id",
        "version",
        "model_id",
        "hash",
        "enabled",
        "lifecycle"
      ],
      "properties": {
        "entry_id": { "type": "string" },
        "version": { "type": "string" },
        "model_id": { "type": "string" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "enabled": { "type": "boolean" },
        "lifecycle": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "outcome",
        "reason_codes",
        "source_artifact_id",
        "source_artifact_hash"
      ],
      "properties": {
        "outcome": { "type": "string" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "source_artifact_id": { "type": ["string", "null"] },
        "source_artifact_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": [
        "blocker_code",
        "severity",
        "category",
        "provider_id",
        "candidate_id",
        "summary",
        "source_evaluator",
        "source_artifact_id",
        "source_artifact_hash",
        "resolvable_by",
        "blocking_execution"
      ],
      "properties": {
        "blocker_code": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "category": { "type": "string" },
        "provider_id": { "type": ["string", "null"] },
        "candidate_id": { "type": ["string", "null"] },
        "summary": { "type": "string" },
        "source_evaluator": { "type": "string" },
        "source_artifact_id": { "type": ["string", "null"] },
        "source_artifact_hash": { "type": ["string", "null"] },
        "resolvable_by": {
          "type": "array",
          "items": {
            "enum": [
              "code_change",
              "evidence_review",
              "legal_review",
              "security_review",
              "human_approval",
              "runtime_configuration",
              "external_account_configuration"
            ]
          }
        },
        "blocking_execution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "action_code",
        "title",
        "owner_role",
        "source_blocker_codes",
        "prerequisite_actions",
        "status",
        "execution_impact",
        "required_artifact"
      ],
      "properties": {
        "action_code": { "type": "string" },
        "title": { "type": "string" },
        "owner_role": { "type": "string" },
        "source_blocker_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prerequisite_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "enum": ["not_started", "pending", "blocked", "complete"] },
        "execution_impact": { "type": "string" },
        "required_artifact": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
