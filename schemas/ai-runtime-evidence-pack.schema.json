{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-runtime-evidence-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "runtime_candidate",
    "captured_at",
    "review_expires_at",
    "sources",
    "findings",
    "event_mapping",
    "portability_findings",
    "privacy_findings",
    "durability_findings",
    "human_review_findings",
    "sandbox_findings",
    "observability_findings",
    "cost_accounting_findings",
    "unresolved_questions",
    "legal_review_required",
    "security_review_required",
    "independent_review_required",
    "lifecycle_recommendation",
    "automatic_promotion_prohibited",
    "reasoning_capture_policy",
    "historical_evidence_classification",
    "pack_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "pack_id": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
    "runtime_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "provider",
        "observed_version",
        "lifecycle_status",
        "activation_prohibited",
        "enabled",
        "kill_switch_active"
      ],
      "properties": {
        "candidate_id": {
          "enum": ["vercel-eve", "cloudflare-agents-workflows"]
        },
        "provider": { "enum": ["vercel", "cloudflare"] },
        "observed_version": {
          "$ref": "ai-tournament-common.schema.json#/$defs/semver"
        },
        "lifecycle_status": { "const": "discovered" },
        "activation_prohibited": { "const": true },
        "enabled": { "const": false },
        "kill_switch_active": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "vercel" } },
            "required": ["provider"]
          },
          "then": {
            "properties": { "candidate_id": { "const": "vercel-eve" } }
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "cloudflare" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "candidate_id": { "const": "cloudflare-agents-workflows" }
            }
          }
        }
      ]
    },
    "captured_at": {
      "$ref": "ai-tournament-common.schema.json#/$defs/date_time"
    },
    "review_expires_at": {
      "$ref": "ai-tournament-common.schema.json#/$defs/date_time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_url",
          "provider",
          "component",
          "document_title",
          "retrieved_at",
          "source_type",
          "document_version",
          "commit_sha",
          "published_or_updated_at",
          "immutable",
          "capture_method",
          "normalized_findings",
          "evidence_limitations",
          "review_expires_at",
          "independent_review_status",
          "approval_status",
          "content_hash"
        ],
        "properties": {
          "source_id": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "provider": { "enum": ["vercel", "cloudflare"] },
          "component": { "type": "string", "minLength": 1 },
          "document_title": { "type": "string", "minLength": 1 },
          "retrieved_at": {
            "$ref": "ai-tournament-common.schema.json#/$defs/date_time"
          },
          "source_type": {
            "enum": [
              "official_repository",
              "official_documentation",
              "official_package_metadata",
              "official_license",
              "official_release",
              "official_changelog"
            ]
          },
          "document_version": { "type": ["string", "null"] },
          "commit_sha": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{40}$"
          },
          "published_or_updated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "immutable": { "type": "boolean" },
          "capture_method": { "const": "public_unauthenticated_http" },
          "normalized_findings": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "review_expires_at": {
            "$ref": "ai-tournament-common.schema.json#/$defs/date_time"
          },
          "independent_review_status": {
            "enum": ["pending", "reviewed", "rejected"]
          },
          "approval_status": { "enum": ["pending", "reviewed", "rejected"] },
          "content_hash": {
            "$ref": "ai-tournament-common.schema.json#/$defs/hash"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "component",
          "topic",
          "claim",
          "claim_status",
          "evidence_strength",
          "source_ids",
          "limitations"
        ],
        "properties": {
          "finding_id": {
            "$ref": "ai-tournament-common.schema.json#/$defs/id"
          },
          "component": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "claim_status": {
            "enum": [
              "verified",
              "documented",
              "inferred",
              "unsupported",
              "undocumented",
              "unknown"
            ]
          },
          "evidence_strength": {
            "enum": ["strong", "moderate", "weak", "none"]
          },
          "source_ids": {
            "type": "array",
            "items": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "event_mapping": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "normalized_event",
          "platform_event",
          "mapping_status",
          "source_ids",
          "limitation"
        ],
        "properties": {
          "normalized_event": {
            "enum": [
              "session_started",
              "turn_started",
              "step_started",
              "action_requested",
              "action_completed",
              "input_requested",
              "authorization_required",
              "subagent_started",
              "subagent_completed",
              "structured_result_completed",
              "usage_recorded",
              "step_completed",
              "turn_completed",
              "session_waiting",
              "session_completed",
              "cancelled",
              "failed"
            ]
          },
          "platform_event": { "type": ["string", "null"] },
          "mapping_status": {
            "enum": [
              "documented",
              "inferred",
              "implementation_specific",
              "unsupported",
              "undocumented"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": { "$ref": "ai-tournament-common.schema.json#/$defs/id" },
            "uniqueItems": true
          },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "portability_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "privacy_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "durability_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "human_review_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "sandbox_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "observability_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "cost_accounting_findings": { "$ref": "#/$defs/nonEmptyStrings" },
    "unresolved_questions": { "$ref": "#/$defs/nonEmptyStrings" },
    "legal_review_required": { "const": true },
    "security_review_required": { "const": true },
    "independent_review_required": { "const": true },
    "lifecycle_recommendation": { "const": "remain_discovered" },
    "automatic_promotion_prohibited": { "const": true },
    "reasoning_capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persist_private_reasoning", "adapter_mode"],
      "properties": {
        "persist_private_reasoning": { "const": false },
        "adapter_mode": { "const": "disabled_or_redacted" }
      }
    },
    "historical_evidence_classification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "classification", "reason"],
        "properties": {
          "evidence_id": {
            "$ref": "ai-tournament-common.schema.json#/$defs/id"
          },
          "classification": {
            "enum": [
              "current",
              "stale",
              "historical",
              "retired",
              "superseded",
              "insufficient"
            ]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pack_hash": { "$ref": "ai-tournament-common.schema.json#/$defs/hash" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
