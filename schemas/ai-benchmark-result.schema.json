{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vlatam.local/schemas/ai-benchmark-result.schema.json","title":"AI benchmark campaign result v1","type":"object","additionalProperties":false,
  "required":["schema_version","campaign","campaign_execution_id","status","profile_runs","profile_summaries","ranking","provenance"],
  "properties":{"schema_version":{"const":"1.0.0"},"campaign":{"$ref":"https://vlatam.local/schemas/ai-benchmark-campaign.schema.json"},"campaign_execution_id":{"$ref":"#/$defs/nonEmpty"},"status":{"enum":["completed","partial","failed"]},"profile_runs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/profileRun"}},"profile_summaries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/profileSummary"}},"ranking":{"$ref":"#/$defs/rankingResult"},"provenance":{"$ref":"#/$defs/provenance"}},
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},"semver":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"count":{"type":"integer","minimum":0},
    "versionedRef":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/semver"}}},
    "profileRef":{"type":"object","additionalProperties":false,"required":["profile_id","profile_version"],"properties":{"profile_id":{"$ref":"#/$defs/id"},"profile_version":{"$ref":"#/$defs/semver"}}},
    "retry":{"type":"object","additionalProperties":false,"required":["attempt_number","max_attempts","retryable","selected_final_attempt"],"properties":{"attempt_number":{"type":"integer","minimum":1},"max_attempts":{"type":"integer","minimum":1},"retryable":{"type":"boolean"},"selected_final_attempt":{"type":"boolean"}}},
    "caseAttempt":{"type":"object","additionalProperties":false,"required":["case_ref","profile","attempt_id","execution_id","audit_correlation_id","status","retry"],"properties":{"case_ref":{"$ref":"#/$defs/versionedRef"},"profile":{"$ref":"#/$defs/profileRef"},"attempt_id":{"$ref":"#/$defs/nonEmpty"},"execution_id":{"$ref":"#/$defs/nonEmpty"},"audit_correlation_id":{"$ref":"#/$defs/nonEmpty"},"status":{"enum":["completed","failed","blocked","rejected"]},"retry":{"$ref":"#/$defs/retry"},"error_code":{"$ref":"#/$defs/nonEmpty"}}},
    "profileRun":{"type":"object","additionalProperties":false,"required":["profile","profile_run_id","audit_correlation_id","attempts","status"],"properties":{"profile":{"$ref":"#/$defs/profileRef"},"profile_run_id":{"$ref":"#/$defs/nonEmpty"},"audit_correlation_id":{"$ref":"#/$defs/nonEmpty"},"attempts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/caseAttempt"}},"status":{"enum":["completed","partial","failed"]}}},
    "ratio":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],"properties":{"numerator":{"$ref":"#/$defs/count"},"denominator":{"type":"integer","minimum":1}}},
    "dimension":{"type":"object","additionalProperties":false,"required":["dimension_id","earned_units","possible_units"],"properties":{"dimension_id":{"$ref":"#/$defs/id"},"earned_units":{"$ref":"#/$defs/count"},"possible_units":{"$ref":"#/$defs/count"}}},
    "usage":{"type":"object","additionalProperties":false,"required":["input_tokens","output_tokens","total_tokens"],"properties":{"input_tokens":{"$ref":"#/$defs/count"},"output_tokens":{"$ref":"#/$defs/count"},"total_tokens":{"$ref":"#/$defs/count"}}},
    "cost":{"type":"object","additionalProperties":false,"required":["amount_minor","currency"],"properties":{"amount_minor":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"currency":{"type":"string","pattern":"^[A-Z]{3,12}$"}}},
    "latency":{"type":"object","additionalProperties":false,"required":["total_ms","maximum_ms"],"properties":{"total_ms":{"$ref":"#/$defs/count"},"maximum_ms":{"$ref":"#/$defs/count"}}},
    "profileSummary":{"type":"object","additionalProperties":false,"required":["profile","eligible_case_count","completed_count","failed_count","blocked_count","rejected_count","score","dimensions","abstention_passed","human_review_required_count","usage_totals","latency","failure_reasons","suite_hash","profile_hash","coverage_complete"],"properties":{"profile":{"$ref":"#/$defs/profileRef"},"eligible_case_count":{"$ref":"#/$defs/count"},"completed_count":{"$ref":"#/$defs/count"},"failed_count":{"$ref":"#/$defs/count"},"blocked_count":{"$ref":"#/$defs/count"},"rejected_count":{"$ref":"#/$defs/count"},"score":{"$ref":"#/$defs/ratio"},"dimensions":{"type":"array","items":{"$ref":"#/$defs/dimension"}},"abstention_passed":{"$ref":"#/$defs/count"},"human_review_required_count":{"$ref":"#/$defs/count"},"usage_totals":{"$ref":"#/$defs/usage"},"exact_cost":{"$ref":"#/$defs/cost"},"latency":{"$ref":"#/$defs/latency"},"failure_reasons":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}},"suite_hash":{"$ref":"#/$defs/hash"},"profile_hash":{"$ref":"#/$defs/hash"},"coverage_complete":{"type":"boolean"}}},
    "rankingEntry":{"type":"object","additionalProperties":false,"required":["profile","eligible","disqualification_reasons"],"properties":{"profile":{"$ref":"#/$defs/profileRef"},"rank":{"type":"integer","minimum":1},"eligible":{"type":"boolean"},"disqualification_reasons":{"type":"array","uniqueItems":true,"items":{"enum":["incomplete_coverage","partial_campaign","schema_or_policy_gate_failed","minimum_quality_not_met"]}}}},
    "rankingResult":{"type":"object","additionalProperties":false,"required":["policy","approved_winner","entries"],"properties":{"policy":{"$ref":"#/$defs/versionedRef"},"approved_winner":{"type":"boolean"},"entries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/rankingEntry"}}}},
    "profileHash":{"type":"object","additionalProperties":false,"required":["profile","hash"],"properties":{"profile":{"$ref":"#/$defs/profileRef"},"hash":{"$ref":"#/$defs/hash"}}},
    "evaluator":{"type":"object","additionalProperties":false,"required":["evaluator_id","evaluator_version"],"properties":{"evaluator_id":{"$ref":"#/$defs/id"},"evaluator_version":{"$ref":"#/$defs/semver"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["campaign_hash","suite_hash","profile_hashes","evaluator","ranking_policy"],"properties":{"campaign_hash":{"$ref":"#/$defs/hash"},"suite_hash":{"$ref":"#/$defs/hash"},"profile_hashes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileHash"}},"evaluator":{"$ref":"#/$defs/evaluator"},"ranking_policy":{"$ref":"#/$defs/versionedRef"}}}
  }
}
