{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/classifier-intelligence-artifact.schema.json",
  "title": "Classifier Intelligence Artifact",
  "description": "Deterministic review-only classifier intelligence artifact produced from a repository-local AI extraction result.",
  "type": "object",
  "required": [
    "artifact_id",
    "extraction_result_id",
    "source_id",
    "generated_at",
    "extracted_evidence",
    "governance",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact--[a-z0-9_-]+--[a-z0-9_-]+$"
    },
    "extraction_result_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ncm_code": { "type": "string" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "type": "string", "const": "candidate" }
      },
      "required": ["status"]
    },
    "extracted_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "text", "requires_review"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim_type": {
            "type": "string",
            "enum": ["tariff", "intervention", "norm", "legal", "classification"]
          },
          "text": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "affected_ncm": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires_review": { "type": "boolean", "const": true }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "human_review_required",
        "downstream_allowed",
        "review_only",
        "not_final_classification"
      ],
      "properties": {
        "human_review_required": { "type": "boolean", "const": true },
        "downstream_allowed": { "type": "boolean", "const": false },
        "review_only": { "type": "boolean", "const": true },
        "not_final_classification": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "additionalProperties": false
}
