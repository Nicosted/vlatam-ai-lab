{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/classifier-intelligence-artifact.schema.json",
  "title": "Classifier Intelligence Artifact",
  "description": "Deterministic review-only classifier intelligence artifact produced from a repository-local AI extraction result.",
  "type": "object",
  "required": [
    "artifact_id",
    "extraction_result_id",
    "source_id",
    "generated_at",
    "extracted_evidence",
    "governance",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact--[a-z0-9_-]+--[a-z0-9_-]+$"
    },
    "extraction_result_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ncm_code": { "type": "string" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "type": "string", "const": "candidate" }
      },
      "required": ["status"]
    },
    "extracted_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "text", "requires_review"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim_type": {
            "type": "string",
            "enum": [
              "tariff",
              "intervention",
              "norm",
              "legal",
              "classification"
            ]
          },
          "text": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "affected_ncm": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires_review": { "type": "boolean", "const": true }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "human_review_required",
        "downstream_allowed",
        "review_only",
        "not_final_classification"
      ],
      "properties": {
        "human_review_required": { "type": "boolean" },
        "downstream_allowed": { "type": "boolean" },
        "review_only": { "type": "boolean" },
        "not_final_classification": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "reviewed_approved", "reviewed_rejected"]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "classifier_approval_reference": {
      "type": "string",
      "minLength": 1
    },
    "downstream_eligibility_reason": {
      "type": "string",
      "minLength": 1
    },
    "review_binding": {
      "$ref": "#/$defs/review_binding"
    },
    "source_authority": {
      "type": "string",
      "enum": ["official_regulation", "internal_review", "synthetic_demo"]
    },
    "origin": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "$defs": {
    "review_binding": {
      "type": "object",
      "required": [
        "binding_schema_version",
        "artifact_id",
        "artifact_schema_version",
        "artifact_content_hash",
        "canonicalization_version",
        "review_decision",
        "reviewed_at",
        "review_policy_id",
        "review_policy_version",
        "review_binding_hash"
      ],
      "properties": {
        "binding_schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact--[a-z0-9_-]+--[a-z0-9_-]+$"
        },
        "artifact_schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "artifact_content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "canonicalization_version": { "type": "string", "minLength": 1 },
        "review_decision": {
          "type": "string",
          "enum": ["approved", "rejected"]
        },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "review_policy_id": { "type": "string", "minLength": 1 },
        "review_policy_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "review_binding_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["governance"],
        "properties": {
          "governance": {
            "type": "object",
            "required": ["downstream_allowed"],
            "properties": {
              "downstream_allowed": { "type": "boolean", "const": true }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "review_status",
          "reviewer",
          "reviewed_at",
          "classifier_approval_reference",
          "review_binding"
        ],
        "properties": {
          "review_status": { "const": "reviewed_approved" },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "classifier_approval_reference": {
            "type": "string",
            "minLength": 1
          },
          "review_binding": {
            "$ref": "#/$defs/review_binding"
          },
          "governance": {
            "type": "object",
            "properties": {
              "human_review_required": { "type": "boolean", "const": false },
              "review_only": { "type": "boolean", "const": false },
              "not_final_classification": { "type": "boolean", "const": false }
            }
          },
          "source_authority": {
            "type": "string",
            "enum": ["official_regulation", "internal_review"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["review_status"],
        "properties": {
          "review_status": {
            "enum": ["reviewed_approved", "reviewed_rejected"]
          }
        }
      },
      "then": {
        "required": ["reviewer", "reviewed_at", "review_binding"],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_binding": { "$ref": "#/$defs/review_binding" }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["source_authority"],
        "properties": {
          "source_authority": { "type": "string", "const": "synthetic_demo" }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "type": "object",
            "properties": {
              "downstream_allowed": { "type": "boolean", "const": false },
              "human_review_required": { "type": "boolean", "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["origin"],
        "properties": {
          "origin": { "type": "string", "const": "synthetic_demo" }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "type": "object",
            "properties": {
              "downstream_allowed": { "type": "boolean", "const": false },
              "human_review_required": { "type": "boolean", "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
