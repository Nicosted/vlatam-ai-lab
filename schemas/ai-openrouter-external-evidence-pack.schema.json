{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-openrouter-external-evidence-pack.schema.json",
  "title": "Reviewed OpenRouter external evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_contract_version",
    "pack_id",
    "pack_version",
    "canonicalization_version",
    "candidate_path",
    "collected_at",
    "records",
    "sandbox_budget_proposal",
    "human_approval",
    "execution_authorized",
    "provider_call_performed",
    "pack_hash"
  ],
  "properties": {
    "pack_contract_version": { "const": "1.0.0" },
    "pack_id": { "$ref": "#/$defs/id" },
    "pack_version": { "$ref": "#/$defs/semver" },
    "canonicalization_version": { "const": "registry-json-v1" },
    "candidate_path": { "$ref": "#/$defs/binding" },
    "collected_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 17,
      "items": { "$ref": "#/$defs/record" }
    },
    "sandbox_budget_proposal": { "$ref": "#/$defs/budget" },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_id", "decided_at"],
      "properties": {
        "status": { "const": "pending" },
        "reviewer_id": { "type": "null" },
        "decided_at": { "type": "null" }
      }
    },
    "execution_authorized": { "const": false },
    "provider_call_performed": { "const": false },
    "pack_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullable_date_time": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dossier_id",
        "provider_id",
        "openrouter_model_id",
        "upstream_provider_id",
        "upstream_model_id",
        "model_registry_entry_id",
        "route_record_id",
        "execution_profile_candidate_id",
        "capability_id"
      ],
      "properties": {
        "dossier_id": { "$ref": "#/$defs/id" },
        "provider_id": { "const": "openrouter" },
        "openrouter_model_id": { "const": "minimax/minimax-m2.7" },
        "upstream_provider_id": { "const": "minimax" },
        "upstream_model_id": { "type": ["string", "null"] },
        "model_registry_entry_id": {
          "const": "openrouter.minimax-m2.7.variable.v1"
        },
        "route_record_id": {
          "const": "openrouter.minimax-m2.7.variable-route.v1"
        },
        "execution_profile_candidate_id": {
          "const": "openrouter.minimax-m2.7.normative-extraction.candidate"
        },
        "capability_id": { "const": "evidence.extraction.normative_claims" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "category",
        "claim",
        "source",
        "normalized_fact",
        "state",
        "reviewer_id",
        "reviewed_at",
        "re_review_at",
        "integrity_hash",
        "conflicts_with",
        "limitations",
        "bindings",
        "attributes"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "category": {
          "enum": [
            "exact_model_identifier",
            "exact_upstream_route",
            "model_lifecycle_release",
            "context_window_limits",
            "modalities",
            "structured_output_json_schema",
            "tool_function_calling",
            "pricing",
            "privacy_policy",
            "retention",
            "training_data_use",
            "zdr",
            "geography_jurisdiction",
            "terms_acceptable_use",
            "capability_benchmark",
            "latency_reliability",
            "known_limitations"
          ]
        },
        "claim": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "publisher",
            "canonical_url",
            "source_type",
            "retrieved_at",
            "published_or_effective_at"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": "string", "minLength": 1 },
            "canonical_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "source_type": {
              "enum": [
                "official_openrouter_documentation",
                "official_openrouter_model_metadata",
                "official_upstream_documentation",
                "official_provider_policy",
                "official_terms",
                "original_model_card",
                "primary_benchmark_publication",
                "authoritative_legal_material"
              ]
            },
            "retrieved_at": { "type": "string", "format": "date-time" },
            "published_or_effective_at": {
              "$ref": "#/$defs/nullable_date_time"
            }
          }
        },
        "normalized_fact": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "missing",
            "unverified",
            "verified",
            "expired",
            "conflicting",
            "not_applicable"
          ]
        },
        "reviewer_id": { "type": ["string", "null"], "minLength": 1 },
        "reviewed_at": { "$ref": "#/$defs/nullable_date_time" },
        "re_review_at": { "type": "string", "format": "date-time" },
        "integrity_hash": { "$ref": "#/$defs/hash" },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bindings": { "$ref": "#/$defs/binding" },
        "attributes": { "type": "object" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_only",
        "maximum_requests",
        "maximum_input_tokens_per_request",
        "maximum_output_tokens_per_request",
        "maximum_total_sandbox_spend",
        "currency",
        "permitted_model_id",
        "permitted_upstream_provider_id",
        "no_fallback",
        "automatic_retries",
        "invocation_mode",
        "expires_at",
        "kill_switch_required"
      ],
      "properties": {
        "metadata_only": { "const": true },
        "maximum_requests": { "type": "integer", "minimum": 1 },
        "maximum_input_tokens_per_request": { "type": "integer", "minimum": 1 },
        "maximum_output_tokens_per_request": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_total_sandbox_spend": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "currency": { "const": "USD" },
        "permitted_model_id": { "const": "minimax/minimax-m2.7" },
        "permitted_upstream_provider_id": { "const": "minimax" },
        "no_fallback": { "const": true },
        "automatic_retries": { "const": 0 },
        "invocation_mode": { "const": "manual_only" },
        "expires_at": { "type": "string", "format": "date-time" },
        "kill_switch_required": { "const": true }
      }
    }
  }
}
