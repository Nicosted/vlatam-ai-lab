{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vlatam.local/arca-scheduler-attempt-ledger-manifest.schema.json",
  "title": "Governed ARCA scheduler authenticated attempt-ledger manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_version",
    "manifest_sha256",
    "canonical_sha256",
    "scheduler_configuration_id",
    "scheduler_configuration_sha256",
    "activation_id",
    "activation_sha256",
    "state_root_identity",
    "state_root_path",
    "initialized_at",
    "reservation_directory",
    "reservations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ledger_version": {
      "const": "1.0.0"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scheduler_configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "scheduler_configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "activation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_root_identity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "state_root_path": {
      "type": "string",
      "minLength": 1
    },
    "initialized_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "reservation_directory": {
      "type": "string",
      "minLength": 1
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reservation_id", "reservation_sha256"],
        "properties": {
          "reservation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reservation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
