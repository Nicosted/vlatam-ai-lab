{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-openrouter-route-registry.schema.json",
  "title": "Versioned fail-closed OpenRouter exact-route registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_registry_contract_version",
    "canonicalization_version",
    "routes"
  ],
  "properties": {
    "route_registry_contract_version": { "const": "1.0.0" },
    "canonicalization_version": { "const": "registry-json-v1" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.:-]*$",
      "not": { "pattern": "^openrouter/" }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_registry_contract_version",
        "route_record_id",
        "route_id",
        "route_version",
        "route_policy_id",
        "route_policy_version",
        "model_id",
        "provider_id",
        "upstream_provider_id",
        "allowed_model_entry_ids",
        "preferred_model_entry_order",
        "fallback_model_entry_order",
        "profile_compatibility",
        "eligibility_requirements",
        "allow_fallbacks",
        "data_collection",
        "structured_output_modes",
        "pricing_contract_id",
        "pricing_contract_version",
        "pricing_evidence_id",
        "pricing_evidence_hash",
        "privacy_evidence_id",
        "privacy_evidence_hash",
        "operational_evidence_id",
        "operational_evidence_hash",
        "route_verification_status",
        "lifecycle",
        "enabled",
        "review_status",
        "reviewed_at",
        "expires_at",
        "supersedes_route_record_id",
        "created_at",
        "route_hash"
      ],
      "properties": {
        "route_registry_contract_version": { "const": "1.0.0" },
        "route_record_id": { "$ref": "#/$defs/id" },
        "route_id": { "$ref": "#/$defs/id" },
        "route_version": { "$ref": "#/$defs/semver" },
        "route_policy_id": { "$ref": "#/$defs/id" },
        "route_policy_version": { "const": "1.0.0" },
        "model_id": { "$ref": "#/$defs/model_id" },
        "provider_id": { "const": "openrouter" },
        "upstream_provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "allowed_model_entry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preferred_model_entry_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "fallback_model_entry_order": {
          "type": "array",
          "maxItems": 0
        },
        "upstream_provider_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "upstream_provider_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "profile_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "execution_profile_contract_version",
            "capability_ids",
            "executable_profile_ids"
          ],
          "properties": {
            "contract_version": { "const": "1.0.0" },
            "execution_profile_contract_version": { "$ref": "#/$defs/semver" },
            "capability_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "executable_profile_ids": { "type": "array", "maxItems": 0 }
          }
        },
        "eligibility_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_evidence_required",
            "reviewed_evidence_required",
            "pricing_contract_required",
            "privacy_zdr_required",
            "exact_upstream_route_required",
            "benchmark_evidence_required",
            "structured_output_required"
          ],
          "properties": {
            "current_evidence_required": { "const": true },
            "reviewed_evidence_required": { "const": true },
            "pricing_contract_required": { "const": true },
            "privacy_zdr_required": { "const": true },
            "exact_upstream_route_required": { "const": true },
            "benchmark_evidence_required": { "const": true },
            "structured_output_required": { "const": true }
          }
        },
        "allow_fallbacks": { "const": false },
        "data_collection": { "const": "deny" },
        "structured_output_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["json_object", "json_schema"] }
        },
        "pricing_contract_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "pricing_contract_version": {
          "anyOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }]
        },
        "pricing_evidence_id": { "$ref": "#/$defs/id" },
        "pricing_evidence_hash": { "$ref": "#/$defs/hash" },
        "privacy_evidence_id": { "$ref": "#/$defs/id" },
        "privacy_evidence_hash": { "$ref": "#/$defs/hash" },
        "operational_evidence_id": { "$ref": "#/$defs/id" },
        "operational_evidence_hash": { "$ref": "#/$defs/hash" },
        "route_verification_status": {
          "enum": [
            "verified_exact",
            "documented_preference_only",
            "response_verified_only",
            "unverified",
            "variable"
          ]
        },
        "lifecycle": {
          "enum": [
            "discovered",
            "evidence_incomplete",
            "benchmark_pending",
            "candidate",
            "approved",
            "degraded",
            "blocked",
            "retired"
          ]
        },
        "enabled": { "const": false },
        "review_status": {
          "enum": [
            "pending",
            "reviewed_with_blockers",
            "reviewed_approved",
            "rejected"
          ]
        },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "supersedes_route_record_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "route_hash": { "$ref": "#/$defs/hash" }
      },
      "dependentRequired": {
        "upstream_provider_order": ["upstream_provider_allowlist"]
      }
    }
  }
}
