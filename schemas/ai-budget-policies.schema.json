{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlatam-ai-lab.local/schemas/ai-budget-policies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policies"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "schema_version",
          "priority",
          "capability_id",
          "execution_mode",
          "request_classification",
          "environment_id",
          "project_id",
          "tenant_id",
          "scope_id",
          "currency",
          "accounting_scale",
          "reservation_rounding_policy",
          "reconciliation_rounding_policy",
          "display_rounding_policy",
          "require_usage",
          "require_verified_pricing",
          "behavior",
          "max_estimated_tokens_per_request",
          "max_actual_tokens_per_request",
          "max_estimated_cost_accounting_units_per_request",
          "max_actual_cost_accounting_units_per_request",
          "rolling_request_limit",
          "rolling_token_limit",
          "rolling_cost_accounting_units_limit",
          "rolling_window_seconds",
          "reservation_ttl_seconds"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "schema_version": { "const": "2.0.0" },
          "priority": { "type": "integer" },
          "capability_id": { "type": "string", "minLength": 1 },
          "profile_id": { "type": "string", "minLength": 1 },
          "profile_class": { "enum": ["development", "unclassified"] },
          "execution_mode": { "enum": ["replay", "live"] },
          "request_classification": { "type": "string", "minLength": 1 },
          "environment_id": { "$ref": "#/$defs/id" },
          "project_id": { "$ref": "#/$defs/id" },
          "tenant_id": { "$ref": "#/$defs/id" },
          "scope_id": { "$ref": "#/$defs/id" },
          "currency": { "const": "USD" },
          "accounting_scale": { "const": "1000000" },
          "reservation_rounding_policy": { "const": "CEILING" },
          "reconciliation_rounding_policy": { "const": "CEILING" },
          "display_rounding_policy": { "const": "HALF_EVEN" },
          "require_usage": { "type": "boolean" },
          "require_verified_pricing": { "type": "boolean" },
          "behavior": { "enum": ["hard_block", "human_review_required"] },
          "max_estimated_tokens_per_request": {
            "type": "integer",
            "minimum": 0
          },
          "max_actual_tokens_per_request": { "type": "integer", "minimum": 0 },
          "max_estimated_cost_accounting_units_per_request": {
            "$ref": "#/$defs/unsigned"
          },
          "max_actual_cost_accounting_units_per_request": {
            "$ref": "#/$defs/unsigned"
          },
          "rolling_request_limit": { "type": "integer", "minimum": 0 },
          "rolling_token_limit": { "type": "integer", "minimum": 0 },
          "rolling_cost_accounting_units_limit": { "$ref": "#/$defs/unsigned" },
          "rolling_window_seconds": { "type": "integer", "minimum": 1 },
          "reservation_ttl_seconds": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "unsigned": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
